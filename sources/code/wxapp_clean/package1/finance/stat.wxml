<view class="range-style flex mar-top">
  <view class="picker-title mr">时间:</view>
  <!-- 时间段 -->  
  <view class="picker_group flex">
    <picker mode="date" value="{{start}}"  end="{{end}}" bindchange="bindDateChange">
      <view class="picker">  
        <text class = "{{start=='开始日期'?'text-style1':'text-style2'}}">{{start}}</text>
      </view>
    </picker>
    <text class = "text-style1">~</text>
    <picker mode="date" value="{{end}}" start="{{start}}" end="2050-01-01" bindchange="bindDateChange2">
      <view class="picker">
      <text class = "{{end=='结束日期'?'text-style1':'text-style2'}}">{{end}}</text>
      </view>
    </picker>
  </view>
  <view class="ml search-action" catchtap="getStat" style="background:var(--action-background);color:#fff;" hover-class="theme-action-hover">搜索</view>
</view>
<view class="time-btn-box">
  <view class="time-btn mr" data-field="1" catchtap="setTime" style="background:var(--action-background);color:#fff;" hover-class="theme-action-hover">今天</view>
  <view class="time-btn mr" data-field="2" catchtap="setTime" style="background:var(--action-background);color:#fff;" hover-class="theme-action-hover">昨天</view>
  <view class="time-btn mr" data-field="3" catchtap="setTime" style="background:var(--action-background);color:#fff;" hover-class="theme-action-hover">本周</view>
  <view class="time-btn mr" data-field="4" catchtap="setTime" style="background:var(--action-background);color:#fff;" hover-class="theme-action-hover">上周</view>
  <view class="time-btn mr" data-field="5" catchtap="setTime" style="background:var(--action-background);color:#fff;" hover-class="theme-action-hover">本月</view>
  <view class="time-btn mr" data-field="6" catchtap="setTime" style="background:var(--action-background);color:#fff;" hover-class="theme-action-hover">上月</view>
</view>
<view style="width: 710rpx;margin: 40rpx 20rpx;">
  <view style="line-height: 24rpx;">
    <view style="width: 10rpx;height: 24rpx;border-radius: 10rpx;background: var(--brand-strong);display: inline-block;margin-right: 10rpx;"></view>
    <text style="font-weight: 700;">总计数据</text>
  </view>
  <view style="margin-top: 30rpx;color: #fff;">
    <view class="flex mt" style="text-align: center;color: #333;font-size: 30rpx;">
      <view class="relative mr" style="width: 345rpx;height: 100rpx;background: #fff;border-radius: 10rpx;padding: 30rpx 0;overflow: hidden;">
        <view class="absolute" style="background: var(--brand-strong);background-image: url({{app.domain}}static/img/dd.png);background-size: 30rpx;background-repeat: no-repeat;background-position: 20rpx 20rpx;width: 60rpx;height: 60rpx;border-radius: 50%;left: -16rpx;top: -16rpx;"></view>
        <view style="line-height: 40rpx;">验券数量</view>
        <view style="font-weight: 700;line-height: 40rpx;margin-top: 10rpx;">{{stat.code_num}}</view>
        <view style="line-height: 20rpx;font-size: 20rpx;" wx:if="{{stat.code_num_dec>0}}">退款数量<text style="color: #26a23b;">{{stat.code_num_dec}}</text></view>
      </view>
      <view class="relative" style="width: 345rpx;height: 100rpx;background: #fff;border-radius: 10rpx;padding: 30rpx 0;overflow: hidden;">
        <view class="absolute" style="background: var(--brand-strong);background-image: url({{app.domain}}static/img/income.png);background-size: 30rpx;background-repeat: no-repeat;background-position: 20rpx 20rpx;width: 60rpx;height: 60rpx;border-radius: 50%;left: -16rpx;top: -16rpx;"></view>
        <view style="line-height: 40rpx;">实际收入(元)</view>
        <view style="font-weight: 700;line-height: 40rpx;margin-top: 10rpx;">{{stat.income}}</view>
        <view style="line-height: 20rpx;font-size: 20rpx;" wx:if="{{stat.income_dec>0}}">退款金额<text style="color: #26a23b;">{{stat.income_dec}}</text></view>
      </view>
    </view>
  </view>
</view>
<view style="width: 710rpx;margin: 40rpx 20rpx;">
  <view style="line-height: 24rpx;">
    <view style="width: 10rpx;height: 24rpx;border-radius: 10rpx;background: var(--brand-strong);display: inline-block;margin-right: 10rpx;"></view>
    <text style="font-weight: 700;">门店数据</text>
  </view>
  <view wx:for="{{stat.store_list}}" wx:key="index" style="background: #fff;width: 670rpx;padding: 20rpx;border-radius: 10rpx;margin-top: 30rpx;">
    <view>
      <text style="font-weight: 700;line-height: 40rpx;">{{item.name}}</text>
    </view>
    <view class="flex" style="text-align: center;padding-top: 20rpx;">
      <view style="width: 333rpx;border-right: 2rpx dashed #ccc;">
        <view style="font-size: 36rpx;color: #333;font-weight: 700;">{{item.code_num}}<text style="color: #26a23b;" wx:if="{{item.code_num_dec>0}}"> - {{item.code_num_dec}}</text></view>
        <view style="font-size: 24rpx;color: #666;">验券数量</view>
      </view>
      <view style="width: 333rpx;border-right: 2rpx dashed #ccc;">
        <view style="font-size: 36rpx;color: #f05510;font-weight: 700;">{{item.income}}<text style="color: #26a23b;" wx:if="{{item.income_dec>0}}"> - {{item.income_dec}}</text></view>
        <view style="font-size: 24rpx;color: #666;">实际收入(元)</view>
      </view>
      <view style="width: 333rpx;">
        <view style="font-size: 36rpx;color: var(--brand-strong);font-weight: 700;">{{item.rate}}%</view>
        <view style="font-size: 24rpx;color: #666;">占比</view>
      </view>
    </view>
  </view>

</view>

<import src="/utils/common/tabbar"></import>
<template is="tabbar" data="{{tabbarData,selected}}"></template>