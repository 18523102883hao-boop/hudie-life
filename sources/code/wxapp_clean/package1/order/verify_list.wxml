<view class="root">
  <van-nav-bar placeholder="true" custom-class="navbar" fixed border="{{false}}" title="核销记录" left-arrow bind:click-left="onClickLeft" />
</view>

<view catchtap="viewOrder" data-id="{{item.id}}" wx:for="{{list}}" wx:key="index" style="width: 670rpx;margin: 20rpx;background: #fff;padding: 20rpx;border-radius: 20rpx;">
  <view style="display: flex;justify-content: space-between;line-height: 40rpx;">
    <view style="font-size: 24rpx;font-weight: 700;">订单号：{{item.no}}</view>
    <view style="font-size: 34rpx;color: #fe0a0a;font-weight: 700;text-align: right;"><text style="font-size: 24rpx;">￥</text>{{item.settle_amount}}</view>
  </view>
  <view style="display: flex;width: 670rpx;margin-top: 10rpx;align-items: stretch;">
    <view style="width: 200rpx;height: 200rpx;">
      <image src="{{item.img}}" style="width: 100%;height: 100%;border-radius: 20rpx;"></image>
    </view>
    <view style="width: 460rpx;margin-left: 10rpx;font-size: 28rpx;color: #555;">
      <view style="font-weight: 700;color: #111;">{{item.store_name}}</view>
      <view style="line-height: 38rpx;display: -webkit-box;-webkit-box-orient: vertical;-webkit-line-clamp: 2;overflow: hidden;text-overflow: ellipsis;height: 76rpx;">{{item.title}}</view>
      <view style="font-size: 24rpx;margin: 4rpx 0;display: flex;justify-content: space-between;"><view>核销券码：</view><view>{{item.code}}</view></view>
      <view style="font-size: 24rpx;margin: 4rpx 0;display: flex;justify-content: space-between;" wx:if="{{item.verify_time}}"><view>消费时间：</view><view>{{item.verify_time}}</view></view>
      <view style="font-size: 24rpx;margin: 4rpx 0;display: flex;justify-content: space-between;color: #ed2519;font-weight: 700;" wx:if="{{item.cancel_time}}"><view>撤销时间：</view><view>{{item.cancel_time}}</view></view>
    </view>
  </view>
</view>

<import src="/utils/common/loading"></import>
<template is="loading" data="{{app,loading,list}}"></template>
<view style="width: 1rpx;height: calc(env(safe-area-inset-bottom) + 20rpx);"></view>