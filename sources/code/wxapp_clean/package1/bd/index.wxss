.range-style{align-items:center;padding-left:10rpx}
.mar-top{margin-top:30rpx}
.picker{font-size:30rpx}
.picker-title{font-size:32rpx;width:110rpx;text-align:right}
.picker_group{color:#888;background:#fff;border:1rpx solid #A4A6AE;border-radius:15rpx;align-items:center;justify-content:space-between;padding:10rpx;font-size:26rpx;width:470rpx}
.text-style1{color:#A4A6AE}
.text-style2{color:rgb(0,0,0,0.8)}
.picker_group picker{font-size:34rpx;height:45rpx;padding-left:20rpx;padding-right:20rpx;line-height:45rpx}
.time-btn-box{width:100%;margin-top:10rpx;text-align:center}
.time-btn-box .time-btn{display:inline-block;width:80rpx;border:1px solid var(--action);border-radius:10rpx;font-size:24rpx;line-height:44rpx}
.time-btn-box .time-btn:last-child{margin-right:0}
.search-action{background:var(--action-background);color:#fff;border-radius:10rpx;}
