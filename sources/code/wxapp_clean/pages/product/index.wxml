          <image catchtap="searchCate" data-name="天天特惠" src="/img/ttth-blue-v1.png" mode="aspectFit" style="width: 90rpx;height: 90rpx;margin: 5rpx auto 0;display: block;"></image>
          <view style="color: {{cate == '天天特惠' ? 'var(--brand-strong)' : '#000'}};">天天特惠</view>
        </view>
        <view style="width: 20%;text-align: center;margin-top: 10rpx;">
          <image catchtap="searchCate" data-name="充值专区" src="/img/czzq-blue-v1.png" mode="aspectFit" style="width: 90rpx;height: 90rpx;margin: 5rpx auto 0;display: block;"></image>
