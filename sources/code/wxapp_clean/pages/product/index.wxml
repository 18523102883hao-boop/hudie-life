<view class="nav-main relative" style="height:calc({{app.globalData.navBarHeight}}px);background: #f3f3f3;">
  <!-- <image src="{{swiperList[0].img}}" style="position: absolute;left: 0;top: 0;width: 100%;height: 90%;filter: blur(5rpx);"></image> -->
  <view style="width: 750rpx;height:{{app.globalData.navBarHeight}}px;background: var(--brand-soft);position: fixed;z-index: 2;top: 0">
  <view class="capsule-box absolute" style="height:{{app.globalData.menuHeight}}px; min-height:{{app.globalData.menuHeight}}px; line-height:{{app.globalData.menuHeight}}px;bottom: 4px;left:{{app.globalData.menuRight}}px;margin-left: 12rpx;">
    <view class="view flex">
        <view class="views" catchtap="searchAddress">
          <view class="flex" style="width: {{area_width}}rpx;font-size: 30rpx;font-weight: 700;">
            <view style="line-height: 60rpx;display: -webkit-box;-webkit-box-orient: vertical;-webkit-line-clamp: 1;overflow: hidden;text-overflow: ellipsis;"><text class="icon iconfont ">{{county?county:(city?city:province)}}</text></view>
            <text class="icon iconfont icon-sanjiaoxing" style="transform: rotate(180deg);font-size: 16rpx;margin-left: 10rpx;"></text>
          </view>
        </view>
        <view class="title" style="color: #333;font-weight: 700;letter-spacing: 4rpx;width: {{150-area_width+360}}rpx;text-align: center;">
          <view style="width: 100%;background: #ffffff88;border-radius: 40rpx;display: flex;border:  {{scroll_top>0?'1rpx solid #f1f1f1;':'none'}}">
            <input type="text" style="width: {{150-area_width+360-60-80}}rpx;margin-left: 60rpx;font-size: 24rpx;font-weight: 100;line-height:{{app.globalData.menuHeight}}px;height:{{app.globalData.menuHeight}}px;" placeholder="搜索" bindinput="setKeywords" bindconfirm="search"/>
            <text class="icon iconfont icon-search" style="width: 80rpx;" catchtap="search"></text>
          </view>
        </view>
        <!-- <view catchtap="showCustomer" style="width: 64rpx;height: 64rpx;text-align: center;background: #ffffff88;border-radius: 50%;font-size: 40rpx;">
          <text class="icon iconfont icon-customer-service-fill"></text>
        </view> -->
        <view class="title" style="opacity: 0;width: 180rpx;margin-top: 0;">
          <view class="flex">
            <text class="icon iconfont icon-dingwei">重庆站</text>
            <text class="icon iconfont icon-down"></text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
<!-- 轮播图 -->
<view class="lun" wx:if="{{swiperList && swiperList.length>0}}">
  <swiper class="luns" autoplay="play" circular interval="3000" bindchange="swiperchange">
    <swiper-item wx:for="{{swiperList}}" wx:key="index" class="luns" bindtap="toPage" data-item="{{item}}">
      <image src="{{item.img}}"></image>
    </swiper-item>
  </swiper>
  <!-- 轮播图标签 -->
  <view class="labels absolute flex">
    <view class="label" wx:if="{{index <= 6}}" wx:for="{{labelAll}}" wx:key="index">{{item}}</view>
  </view>
  <!-- 轮播图下点 -->
  <view class="points pointss flex" wx:if="{{swiperList.length > 1}}">
    <view class="{{swiperIndex == index ?'pointe':'point'}}" wx:for="{{swiperList.length}}" wx:key="index">
    </view>
  </view>
</view>

