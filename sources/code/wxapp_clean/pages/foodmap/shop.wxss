er-radius:20rpx;margin-bottom:20rpx;padding:20rpx;gap:18rpx}.package-image-wrap{width:190rpx;position:relative;flex-shrink:0}.package-image{width:190rpx;height:190rpx;border-radius:12rpx}.countdown{position:absolute;bottom:0;left:0;right:0;background:var(--action-background);border-radius:0 0 12rpx 12rpx;color:white;font-size:19rpx;text-align:center;line-height:36rpx}.package-body{flex:1;min-width:0;display:flex;flex-direction:column;justify-content:space-between}.package-name{font-size:27rpx;font-weight:600;line-height:1.55;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.sales{color:#90989e;font-size:22rpx;margin:14rpx 0}.purchase-line{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.purchase-amount{flex:1;min-width:0;line-height:1.5}.price{font-size:34rpx;color:var(--action);font-weight:700}.market-price{font-size:21rpx;color:#aaa;text-decoration:line-through;margin-left:8rpx}.buy-button{box-sizing:border-box;display:flex;align-items:center;justify-content:center;width:136rpx;max-width:136rpx;min-width:0;height:52rpx;min-height:0;font-size:22rpx;line-height:52rpx;padding:0;margin:0;border-radius:26rpx;color:white;background:var(--action-background);flex:0 0 136rpx}.buy-button::after,.share-button::after{border:0}.expired{background:#bbb;color:white}.state{text-align:center;color:#89939b;padding:40rpx 20rpx;line-height:1.8}.link{color:var(--brand-strong);margin-left:16rpx}.share-footer{position:fixed;bottom:0;left:0;right:0;background:white;padding:12rpx 32rpx calc(12rpx + env(safe-area-inset-bottom));box-shadow:0 -4rpx 20rpx #0001}.share-button{box-sizing:border-box;width:220rpx;max-width:100%;height:60rpx;min-height:0;margin:0 auto;padding:0;font-size:24rpx;line-height:60rpx;border-radius:30rpx;background:var(--action-background);color:white}
