@import "../../utils/theme.wxss";
page{background:var(--page-background);color:var(--text);font-size:26rpx}.stores-page{padding:24rpx 24rpx calc(32rpx + env(safe-area-inset-bottom))}.stores-heading{font-size:32rpx;font-weight:700;padding:12rpx 4rpx 28rpx}.muted{font-size:25rpx;color:#92999f;font-weight:400;margin-left:14rpx}.branch-card{background:white;padding:28rpx;border-radius:22rpx;margin-bottom:22rpx}.branch-name{font-size:30rpx;font-weight:600;display:flex;justify-content:space-between;align-items:center;line-height:1.5}.branch-arrow{font-weight:400;color:#999;font-size:36rpx;margin-left:20rpx}.branch-address{margin-top:18rpx;line-height:1.7;color:#777}.distance{color:var(--brand-strong);font-size:24rpx;margin-top:10rpx}.branch-actions{margin-top:22rpx;padding-top:22rpx;border-top:1rpx solid #edf0f2;display:flex;justify-content:space-between;align-items:center;gap:20rpx}.branch-phone{flex:1;min-width:0;color:var(--brand-strong);font-size:25rpx}.navigate{border-radius:30rpx;padding:14rpx 24rpx;background:var(--action-background);color:white;font-size:24rpx;flex-shrink:0}.navigate-disabled{background:#f0f2f4;color:#999}.state{padding:48rpx 24rpx;text-align:center;color:#92999f;line-height:1.8}.link{color:var(--brand-strong);margin-left:16rpx}
