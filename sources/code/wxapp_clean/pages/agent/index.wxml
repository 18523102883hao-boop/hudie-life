<view style="width: 100%;overflow-x: hidden;">
  <view class="nav-main relative" style="height:{{app.globalData.navBarHeight}}px;">
    <!-- 胶囊区域 -->
    <view class="capsule-box absolute" style="height:{{app.globalData.menuHeight}}px;min-height:{{app.globalData.menuHeight}}px;line-height:{{app.globalData.menuHeight}}px;bottom:{{app.globalData.menuBotton}}px;left:{{app.globalData.menuRight}}px;margin-left: 50%;transform: translate(-50%);">
      <!-- 导航内容区域 -->
      <view class="view flex">
        <view class="views" catchtap="back">
          <text class="icon iconfont icon-fanhui"></text>
        </view>
        <view class="title">我的金库</view>
        <view class="title" style="opacity: 0;">12情</view>
      </view>
    </view>
  </view>
  <view style="width: 750rpx;height: 620rpx;overflow: hidden;position: absolute;top: 0;left: 0;z-index:-1;background-image: linear-gradient(to bottom, var(--brand-soft) 75%, #f3f3f3)">
    <view class="bgc absolute"></view>
  </view>

  <!-- 用户 -->
  <view class="user mt mb flex relative">
    <view class="user_img mr">
      <image src="{{userinfo.img}}"></image>
    </view>
    <view class="user_tit">
      <view class="user_name">{{userinfo.nickname || '用户昵称'}}</view>
    </view>
    <view class="absolute" style="right: 40rpx;font-size: 40rpx;color: #fff;opacity: 0;">
      <text class="icon iconfont icon-settings"></text>
    </view>
  </view>

  <view style="width: 710rpx;margin: 20rpx;border-radius: 20rpx;overflow: hidden;">
    <view style="height: 80rpx;width: 100%;background-image: linear-gradient(to bottom right, var(--brand-soft), var(--brand-border));position: relative;">
      <view style="font-size: 30rpx;line-height: 80rpx;margin-bottom: 10rpx;color: var(--brand-strong);text-indent: 20rpx;">
        我获得的蝴蝶币总数 
        <view style="background: var(--brand);display: inline-block;height: 44rpx;line-height: 44rpx;font-size: 20rpx;color: #fff;border-radius: 22rpx 22rpx 22rpx 0;padding-right: 10rpx;position: absolute;top: 18rpx;margin-left: 20rpx;">满{{stat.min_withdraw}}蝴蝶币即可提现，快快推广吧！</view>
      </view>
    </view>
    <view wx:if="{{userinfo.is_agent > 1}}" style="width: 670rpx;background: linear-gradient(to right top, var(--brand), var(--brand-strong));padding: 20rpx;display: flex;justify-content: space-between;flex-wrap: wrap;color: #fff;text-shadow: 0 1rpx 2rpx rgba(0, 40, 75, .28);">
      <view style="width: 500rpx;">
        <view style="font-size: 50rpx;line-height: 60rpx;font-weight: 700;color: #fff;">{{stat.total}}</view>
      </view>
      <view style="width: 170rpx;">
        <view hover-class="theme-action-hover" catchtap="toWithdraw" style="line-height: 60rpx;background:var(--action-background);text-align: center;color: #fff;font-weight: 700;border-radius: 30rpx;font-size: 28rpx;text-shadow:none;">兑现</view>
      </view>
      <!-- <view style="color: #d1d0ce;width: 670rpx;line-height: 80rpx;font-size: 26rpx;">1 蝴蝶币可兑换 ￥1</view> -->
      <view style="width: 670rpx;display: flex;text-align: center;flex-wrap: wrap;margin-top: 20rpx">
        <view style="width: 33.33333%;position: relative;padding-bottom: 20rpx;">
          <view style="color: #fff;font-size: 30rpx;">可兑现</view>
          <view style="color: #fff;font-weight: 700;font-size: 40rpx;">{{userinfo.coin}}</view>
        </view>
        <view style="width: 33.33333%;position: relative;padding-bottom: 20rpx;">
          <view style="color: #fff;font-size: 30rpx;" catchtap="tipExchanged">已兑现 <text class="icon iconfont icon-help"></text></view>
          <view style="color: #fff;font-weight: 700;font-size: 40rpx;"
            catchtap="toPage"
            data-entry="exchanged"
            data-page="/pages/agent/withdraw_list?source=exchanged"
          >{{stat.exchanged_withdrew}}</view>
        </view>
        <view style="width: 33.33333%;position: relative;padding-bottom: 20rpx;">
          <view style="color: #fff;font-size: 30rpx;" catchtap="tipWithdrawing">兑现中 <text class="icon iconfont icon-help"></text></view>
          <view style="color: #fff;font-weight: 700;font-size: 40rpx;">{{stat.withdrawing}}</view>
        </view>
        <view style="width: 33.33333%;position: relative;padding-bottom: 20rpx;">
          <view style="color: #fff;font-size: 30rpx;">直卖收益</view>
          <view style="color: #fff;font-size: 28rpx;">{{stat.direct_coin}}</view>
        </view>
        <view style="width: 33.33333%;position: relative;padding-bottom: 20rpx;">
          <view style="color: #fff;font-size: 30rpx;">团队收益</view>
          <view style="color: #fff;font-size: 28rpx;">{{stat.group_coin}}</view>
        </view>
        <view style="width: 33.33333%;position: relative;padding-bottom: 20rpx;">
          <view style="color: #fff;font-size: 30rpx;" catchtap="tipCoin">预收获 <text class="icon iconfont icon-help"></text></view>
          <view style="color: #fff;font-size: 28rpx;">{{stat.coin}}</view>
        </view>
      </view>
    </view>
  </view>

  <view style="display: flex;width: 710rpx;margin-left: 20rpx;text-align: center;line-height: 24rpx;margin-top: 30rpx;font-size: 24rpx;font-weight: 700;">
    <view style="width: 33.3333%;" catchtap="selIndex" data-index="1">
      <view style="color: {{index==1?'var(--brand-strong)':'#000'}};">收益报表</view>
      <view wx:if="{{index==1}}" style="display: inline-block;width: 50rpx;height: 8rpx;background: var(--brand);"></view>
    </view>
    <view style="width: 33.3333%;" catchtap="selIndex" data-index="2">
      <view style="color: {{index==2?'var(--brand-strong)':'#000'}};">收益订单</view>
      <view wx:if="{{index==2}}" style="display: inline-block;width: 50rpx;height: 8rpx;background: var(--brand)"></view>
    </view>
    <view style="width: 33.3333%;" catchtap="selIndex" data-index="3">
      <view style="color: {{index==3?'var(--brand-strong)':'#000'}};">我的团队</view>
      <view wx:if="{{index==3}}" style="display: inline-block;width: 50rpx;height: 8rpx;background: var(--brand)"></view>
    </view>
  </view>

  <view wx:if="{{index==1}}">
    <view class="shop mtrbl flex" style="margin-top: 20rpx;">
      <view class="item_top flex">
        <view class="top_address relative">今日</view>
      </view>
      <view style="width: 670rpx;display: flex;color: #9c9c9c;font-size: 24rpx;margin-top: 20rpx;">
        <view style="width: 33.3333%;">
          <view>累计收益</view>
          <view style="color: #000;font-weight: 700;font-size: 36rpx;">{{commission_stat.today.coin}}</view>
          <!-- <view style="color: #fb7e31;font-size: 20rpx;background: #fef4e8;display: inline-block;padding: 2rpx 4rpx;border-radius: 8rpx;border: 1px solid #fb7e3144;font-weight: 700;"><text class="icon iconfont icon-up-arrow"> 相比昨日上涨0%</text></view> -->
        </view>
        <view style="width: 33.3333%;">
          <view>累计订单</view>
          <view style="color: #000;font-weight: 700;font-size: 36rpx;">{{commission_stat.today.order_num}}</view>
          <!-- <view style="color: #fb7e31;font-size: 20rpx;background: #fef4e8;display: inline-block;padding: 2rpx 4rpx;border-radius: 8rpx;border: 1px solid #fb7e3144;font-weight: 700;"><text class="icon iconfont icon-up-arrow"> 相比昨日上涨0%</text></view> -->
        </view>
        <view style="width: 33.3333%;">
          <view>新增下级</view>
          <view style="color: #000;font-weight: 700;font-size: 36rpx;">{{commission_stat.today.user_num}}</view>
          <!-- <view style="color: #fb7e31;font-size: 20rpx;background: #fef4e8;display: inline-block;padding: 2rpx 4rpx;border-radius: 8rpx;border: 1px solid #fb7e3144;font-weight: 700;"><text class="icon iconfont icon-up-arrow"> 相比昨日上涨0%</text></view> -->
        </view>
      </view>
    </view>
    
    <view class="shop mtrbl flex" style="margin-top: 20rpx;">
      <view class="item_top flex">
        <view class="top_address relative">昨日</view>
      </view>
      <view style="width: 670rpx;display: flex;color: #9c9c9c;font-size: 24rpx;margin-top: 20rpx;">
        <view style="width: 33.3333%;">
          <view>累计收益</view>
          <view style="color: #000;font-weight: 700;font-size: 36rpx;">{{commission_stat.yesterday.coin}}</view>
        </view>
        <view style="width: 33.3333%;">
          <view>累计订单</view>
          <view style="color: #000;font-weight: 700;font-size: 36rpx;">{{commission_stat.yesterday.order_num}}</view>
        </view>
        <view style="width: 33.3333%;">
          <view>新增下级</view>
          <view style="color: #000;font-weight: 700;font-size: 36rpx;">{{commission_stat.yesterday.user_num}}</view>
        </view>
      </view>
    </view>
    
    <view class="shop mtrbl flex" style="margin-top: 20rpx;">
      <view class="item_top flex">
        <view class="top_address relative">本周</view>
      </view>
      <view style="width: 670rpx;display: flex;color: #9c9c9c;font-size: 24rpx;margin-top: 20rpx;">
        <view style="width: 33.3333%;">
          <view>累计收益</view>
          <view style="color: #000;font-weight: 700;font-size: 36rpx;">{{commission_stat.week.coin}}</view>
        </view>
        <view style="width: 33.3333%;">
          <view>累计订单</view>
          <view style="color: #000;font-weight: 700;font-size: 36rpx;">{{commission_stat.week.order_num}}</view>
        </view>
        <view style="width: 33.3333%;">
          <view>新增下级</view>
          <view style="color: #000;font-weight: 700;font-size: 36rpx;">{{commission_stat.week.user_num}}</view>
        </view>
      </view>
    </view>
    
    <view class="shop mtrbl flex" style="margin-top: 20rpx;">
      <view class="item_top flex">
        <view class="top_address relative">本月</view>
      </view>
      <view style="width: 670rpx;display: flex;color: #9c9c9c;font-size: 24rpx;margin-top: 20rpx;">
        <view style="width: 33.3333%;">
          <view>累计收益</view>
          <view style="color: #000;font-weight: 700;font-size: 36rpx;">{{commission_stat.month.coin}}</view>
        </view>
        <view style="width: 33.3333%;">
          <view>累计订单</view>
          <view style="color: #000;font-weight: 700;font-size: 36rpx;">{{commission_stat.month.order_num}}</view>
        </view>
        <view style="width: 33.3333%;">
          <view>新增下级</view>
          <view style="color: #000;font-weight: 700;font-size: 36rpx;">{{commission_stat.month.user_num}}</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{index == 2}}">
    <view wx:for="{{list}}" wx:key="index" style="width: 670rpx;margin: 20rpx;background: #fff;padding: 20rpx;border-radius: 20rpx;">
      <view style="display: flex;justify-content: space-between;line-height: 40rpx;">
        <view style="font-size: 24rpx;font-weight: 700;">订单号：{{item.no}}</view>
        <view style="font-size: 30rpx;">
          <view wx:if="{{item.status == 1}}" style="background: #d3edff;border-color: #54c5fd;color: #00a1f3;">待支付</view>
          <view wx:elif="{{item.status == 2}}" style="background: #f6ffed;border-color: #b7eb8f;color: #52c41a;">待使用</view>
          <view wx:elif="{{item.status == 3}}" style="background: #f6ffed;border-color: #b7eb8f;color: #52c41a;">已完成</view>
          <view wx:elif="{{item.status == 4}}" style="background: #fffde4;border-color: #fdf7a5;color: #ffee00;">已过期</view>
          <view wx:elif="{{item.status == 9}}" style="background: #fff1f0;border-color: #ffa39e;color: #f5222d;">已退款</view>
          <view wx:elif="{{item.status == -1}}" style="background: #ffffff;border-color: #f4f4f4;color: #333333;">已取消</view>
          <view wx:else style="background: #ffffff;border-color: #f4f4f4;color: #999;">未知</view>
        </view>
      </view>
      <view style="display: flex;width: 670rpx;margin-top: 20rpx;align-items: stretch;">
        <view style="width: 200rpx;height: 200rpx;">
          <image src="{{item.img}}" style="width: 100%;height: 100%;border-radius: 20rpx;"></image>
        </view>
        <view style="width: 460rpx;margin-left: 10rpx;font-size: 28rpx;color: #555;">
          <view style="font-weight: 700;color: #111;">{{item.shop_name}}</view>
          <view style="line-height: 38rpx;display: -webkit-box;-webkit-box-orient: vertical;-webkit-line-clamp: 2;overflow: hidden;text-overflow: ellipsis;height: 76rpx;">{{item.title}}</view>
          <view style="font-size: 24rpx;margin: 4rpx 0;display: flex;justify-content: space-between;">
            <block wx:if="{{item.pay_time}}">
              <view>支付时间：</view><view>{{item.pay_time}}</view>
            </block>
            <view wx:else>⠀</view>
          </view>
          <view style="font-size: 24rpx;margin: 4rpx 0;display: flex;justify-content: space-between;">
            <block wx:if="{{item.refund_time}}">
              <view>退款时间：</view><view>{{item.refund_time}}</view>
            </block>
            <view wx:else>⠀</view>
          </view>
          <view style="font-size: 34rpx;color: #fe0a0a;font-weight: 700;text-align: right;">+ <text style="font-size: 24rpx;">￥</text>{{item.commission}}</view>
        </view>
      </view>
    </view>
  </view>
  
  <view wx:if="{{index == 3}}">
    <view wx:for="{{user_list}}" wx:key="index" style="width: 670rpx;padding: 20rpx 20rpx 4rpx;border-radius: 20rpx;background: #fff;margin: 20rpx;display: flex;justify-content: space-between;line-height: 60rpx;flex-wrap: wrap;">
      <view style="display: flex;width: 470rpx;position: relative;">
        <image src="{{item.img}}" style="width: 60rpx;height: 60rpx;border-radius: 50%;"></image>
        <text style="margin-left: 20rpx;width: 200px;white-space: nowrap;overflow: hidden;text-overflow: ellipsis;">{{item.nickname}}</text>
        <view wx:if="{{item.is_agent>1}}" style="height: 30rpx;width: 30rpx;position: absolute;top: 40rpx;left: 40rpx;overflow: hidden;border-radius: 50%;">
          <image src="{{app.domain}}static/img/icon-agent{{item.is_agent == 3?'-red':''}}.png" style="width: 105.47rpx;height: 30rpx;position: absolute;top: 0;left: -2rpx"></image>
        </view>
      </view>
      <view style="width: 200rpx;text-align: right;">{{item.mobile}}</view>
      <view style="width: 400rpx;font-size: 24rpx;">团队人数：{{item.num}}</view>
      <view style="width: 270rpx;font-size: 24rpx;text-align: right;color: #666;">{{item.bind_time}}</view>
    </view>
  </view>
</view>

<view wx:if="{{index>1&&loading}}" style="text-align: center;display: flex;justify-content: space-around;">
  <view style="display: flex;font-size: 24rpx;line-height: 48rpx;color: #888;">
    <image src="{{app.domain}}/static/img/loading.gif" style="width: 48rpx;height: 48rpx;"></image>
    <text style="margin-left: 10rpx;">加载中...</text>
  </view>
</view>
<view wx:if="{{loading == 0 && ((index==2&&list.length==0)||(index==3&&user_list.length==0))}}">
  <image src="{{app.domain}}/static/img/nodata.png" style="width: 368rpx;height: 480rpx;margin-left: 191rpx;"></image>
</view>

<view style="width: 750rpx;height: calc(env(safe-area-inset-bottom));background: #f1f1f1;"></view>
