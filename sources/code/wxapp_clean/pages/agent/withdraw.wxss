page{background:#f6f6f6;color:#272733}
.root{min-height:100vh;box-sizing:border-box;padding-bottom:calc(220rpx + env(safe-area-inset-bottom));background:linear-gradient(var(--brand-border) 0,var(--brand-soft) 340rpx,#f6f6f6 560rpx);--nav-bar-background-color:var(--brand-soft);--nav-bar-title-text-color:#272733;--nav-bar-icon-color:var(--brand-strong)}
.root .van-icon-arrow-left{color:var(--nav-bar-icon-color,var(--brand-strong)) !important;z-index:10}
.root .van-nav-bar{color:#272733 !important;background-color:var(--brand-soft) !important}
.card{width:690rpx;height:204rpx;background:linear-gradient(to right top,var(--brand),var(--brand-strong));opacity:1;border-radius:24rpx;margin-left:30rpx;padding:1rpx;box-sizing:border-box;box-shadow:0 12rpx 30rpx #2020370a}
.c_title{width:128rpx;height:44rpx;font-size:32rpx;font-family:PingFang SC-Regular,PingFang SC;font-weight:400;color:#fff;line-height:44rpx;margin-top:32rpx}
.price{width:152rpx;height:74rpx;font-size:60rpx;font-family:Roboto-Regular,Roboto;font-weight:400;color:#fff;line-height:74rpx}
.list{width:100%;justify-content:right;flex-direction:row-reverse;height:48rpx;font-size:24rpx;font-family:PingFang SC-Regular,PingFang SC;font-weight:400;color:#fff;line-height:48rpx;bottom:20rpx;right:20rpx}
.t_title{height:40rpx;font-size:28rpx;font-family:PingFang SC-Regular,PingFang SC;font-weight:400;color:#272733;line-height:40rpx;margin-top:30rpx;margin-left:30rpx}
.content{width:690rpx;height:100rpx;background:#fff;border-radius:20rpx 20rpx 20rpx 20rpx;opacity:1;margin-top:10rpx;margin-left:30rpx;flex-direction:row;justify-content:left;align-items:center;padding-left:20rpx;box-sizing:border-box}
.content input{margin-left:10rpx;height:40rpx;font-size:28rpx;font-family:PingFang SC-Regular,PingFang SC;font-weight:400;line-height:40rpx;color:#272733;caret-color:var(--brand-strong)}
.withdraw-rule{box-sizing:border-box;width:690rpx;margin:16rpx 0 0 30rpx;padding:22rpx 24rpx;border-radius:20rpx;background:#fff}
.withdraw-rule-title{color:var(--brand-strong);font-size:28rpx;font-weight:600;line-height:40rpx}
.withdraw-rule-text{margin-top:10rpx;color:#555;font-size:25rpx;line-height:40rpx;white-space:pre-wrap;word-break:break-word}
.uploadItem{margin-top:10rpx;margin-left:30rpx}
.upload{width:200rpx;height:200rpx;background:#fff;border-radius:20rpx 20rpx 20rpx 20rpx;opacity:1;text-align:center;line-height:200rpx;font-size:80rpx;font-weight:200}
.submit{width:440rpx;height:72rpx;background:var(--action-background);border-radius:40rpx;opacity:1;font-size:32rpx;font-family:PingFang SC-Regular,PingFang SC;font-weight:600;color:#fff;line-height:72rpx;text-align:center;bottom:calc(120rpx + env(safe-area-inset-bottom));left:50%;transform:translate(-50%,0%);box-shadow:0 8rpx 24rpx rgba(8,121,181,.1)}

