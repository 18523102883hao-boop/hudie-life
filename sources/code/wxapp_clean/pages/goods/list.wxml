        </view>
        <view style="width: 336rpx;line-height: 20rpx;font-size: 20rpx;display: flex;flex-wrap: wrap;">
          <view style="color: #ff0a0a;border-radius: 10rpx;margin-right: 6rpx;margin-top: 6rpx;font-weight: 700;font-size: 22rpx;background-image: url({{app.domain}}static/img/icon-commission.png);background-size: 20rpx 20rpx;background-repeat: no-repeat;padding-left: 26rpx;" wx:if="{{item.max_commission}}">自购省 {{item.max_commission}} | 分享赚 {{item.max_commission}}</view>
        </view>
      </view>
      <view style="width: 220rpx;height: 90rpx;display: flex;align-items: flex-end;justify-content: flex-end;">
        <view wx:if="{{item.status!=1}}" style="width: 180rpx;height: 56rpx;font-weight: 700;font-size: 24rpx;display: flex;justify-content: center;background-image: linear-gradient(to right, #f1f1f1, #d1d1d1);background-size: 100% 100%;line-height: 56rpx;text-align: center;border-radius: 28rpx;text-align: center;color: #333">
          {{item.start_time <= now_time ? '已下架' : '未上架'}}
        </view>
        <view wx:elif="{{item.end_time<now_time}}" style="width: 180rpx;height: 56rpx;font-weight: 700;font-size: 24rpx;display: flex;justify-content: center;background-image: linear-gradient(to right, #f1f1f1, #d1d1d1);background-size: 100% 100%;line-height: 56rpx;text-align: center;border-radius: 28rpx;text-align: center;color: #333">
          已下架
        </view>
        <view wx:elif="{{item.start_time>now_time}}" style="width: 180rpx;height: 56rpx;font-weight: 700;font-size: 24rpx;display: flex;justify-content: center;background-image: linear-gradient(to right, #ffe79c, #ffbb17);background-size: 100% 100%;line-height: 56rpx;text-align: center;border-radius: 28rpx;text-align: center;color: #fff">{{item.start_date}} 开售</view>
        <view wx:elif="{{item.stock<=item.today_sale_num}}" style="width: 180rpx;height: 56rpx;font-weight: 700;font-size: 24rpx;display: flex;justify-content: center;background-image: linear-gradient(to right, #f1f1f1, #d1d1d1);background-size: 100% 100%;line-height: 56rpx;text-align: center;border-radius: 28rpx;text-align: center;color: #333">已抢光</view>
        <view hover-class="theme-action-hover" wx:elif="{{item.type == 1}}" style="width: 220rpx;height: 56rpx;font-weight: 700;font-size: 24rpx;display: flex;align-items: flex-end;justify-content: flex-end;border-radius: 28rpx;background-size: 100% 100%;line-height: 56rpx;text-align: center;background:var(--action-background);color:#fff;">
          <view style="width: 110rpx;height: 56rpx;color: #fff;font-size: 20rpx;">最低砍至</view>
          <view style="width: 110rpx;height: 56rpx;color: #fff;">￥{{item.min_price}}</view>
        </view>
        <view hover-class="theme-action-hover" wx:elif="{{item.type == 3}}" style="width: 180rpx;height: 56rpx;font-weight: 700;font-size: 24rpx;display: flex;align-items: flex-end;justify-content: flex-end;background:var(--action-background);background-size: 100% 100%;line-height: 56rpx;text-align: center;border-radius: 28rpx;text-align: center;color: #fff">
          {{item.group_num}}人团
        </view>
        <view hover-class="theme-action-hover" wx:else style="width: 180rpx;height: 56rpx;font-weight: 700;font-size: 24rpx;display: flex;justify-content: center;background:var(--action-background);background-size: 100% 100%;line-height: 56rpx;text-align: center;border-radius: 28rpx;text-align: center;color: #fff">
          立即购买
        </view>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{show_cut_msg}}" style="position: fixed;left: 0;top: 0;background: #00000066;z-index: 9;width: 100%;height: 100%;">
  <view hover-class="theme-action-hover" style="position: absolute;right: 125rpx;top: calc(50vh - 250rpx);z-index: 1;font-size: 24rpx;width: 120rpx;text-align: center;line-height: 40rpx;border-radius: 20rpx;background:var(--action-background);color:#fff;" catchtap="closeCutMsg">关闭 {{sec>0?sec:''}}</view>
  <view style="position: absolute;height: 587rpx;width: 686rpx;left: 32rpx;top: calc(50vh - 293.5rpx);border-radius: 20rpx;">
    <image src="{{app.domain}}static/img/cut_alert.png?t=1" style="width: 100%;height: 100%;"></image>
    <view style="line-height: 80rpx;font-size: 60rpx;color: #fe0a0a;font-weight: 700;text-align: center;width: 286rpx;position: absolute;top: 282rpx;left: 200rpx;">{{cut_price}}元</view>
    <view style="width: 410rpx;font-size: 24rpx;text-align: center;color: #fff;position: absolute;top: 410rpx;left: 138rpx">砍价成功，当前商品最终价格仅当日有效，先抢先得</view>
  </view>
</view>
<view wx:if="{{show_share}}" style="position: fixed;left: 0;top: 0;background: #00000066;z-index: 9;width: 100%;height: 100%;">
  <view style="position: absolute;width: 620rpx;height: 850rpx;left: 65rpx;top: calc((100vh - 850rpx - env(safe-area-inset-bottom) - 390rpx +  {{app.globalData.navBarHeight}}px) / 2)" wx:if="{{goods.poster}}">
    <image show-menu-by-longpress src="{{goods.poster}}" style="width: 620rpx;height: 850rpx;"></image>
  </view>
  <view style="position: absolute;bottom: 0;left: 0;">
    <view style="background: #fff;padding: 30rpx 40rpx 20rpx;border-radius: 20rpx 20rpx 0 0;">
      <view style="display: flex;text-align: center;border-bottom: 1px solid #f1f1f1;padding-bottom: 20rpx;">
        <button plain="true" open-type="share" hover-class="theme-share-hover" style="width: 33.33%;box-sizing: border-box;padding: 0;border: 0;font-weight: 100;font-size: 28rpx;border-right: 1px solid #f1f1f1;">
          <view class="theme-action-icon" style="background:var(--action-background);width: 109rpx;height: 108rpx;color: #fff;font-size: 70rpx;line-height: 108rpx;border-radius: 24rpx;display: inline-block;">↗</view>
          <view>发送给好友</view>
        </button>
        <view hover-class="theme-share-hover" catchtap="savePoster" style="width: 33.33%;border-right: 1px solid #f1f1f1;box-sizing: border-box;font-weight: 100;font-size: 28rpx;">
          <view class="theme-action-icon" style="border-radius:24rpx;background:var(--action-background);width: 109rpx;height: 108rpx;color:#fff;font-size:64rpx;line-height:108rpx;display:inline-block;"><text class="icon iconfont icon-save"></text></view>
          <view>保存海报</view>
        </view>
        <view hover-class="theme-share-hover" catchtap="toBuy" style="width: 33.33%;font-weight: 100;font-size: 28rpx;">
          <view class="theme-action-icon" style="border-radius:24rpx;background:var(--action-background);width: 109rpx;height: 108rpx;color:#fff;font-size:64rpx;line-height:108rpx;display:inline-block;">¥</view>
          <view>立即购买</view>
        </view>
      </view>
      <view style="text-align: center;margin-top: 20rpx;" catchtap="closeShare">关闭</view>
    </view>
    <view style="width: 750rpx;height: calc(env(safe-area-inset-bottom));background: #f1f1f1;"></view>
  </view>
</view>

<view hover-class="theme-action-hover" style="width: 170rpx;height: 178rpx;font-weight: 700;font-size: 28rpx;line-height: 178rpx;text-align: center;border-radius: 24rpx;background-size: 100%;position: fixed;z-index: 6;bottom: calc(200rpx + env(safe-area-inset-bottom) + 80rpx);right: 10rpx;background:var(--action-background);color:#fff;" catchtap="toPage" data-path="/pages/join_us/qun">加入福利群</view>
<view style="width: 120rpx;height: 120rpx;background-image: url('{{app.domain}}static/img/icon-float-kf.png');background-size: 100%;position: fixed;z-index: 6;bottom: calc(80rpx + env(safe-area-inset-bottom) + 80rpx);right: 34rpx;" catchtap="showKf" data-path="/pages/join_us/add_customer"></view>
<view wx:if="{{show_kf}}" catchtap="hideKf" style="width: 100%;height: 100%;position: fixed;top: 0;left: 0;z-index: 8;background: #00000060">
  <image src="{{app.domain}}static/img/kf_qrcode.png" style="width: 650rpx;height: 930.526rpx;position: relative;left: 50rpx;top: calc(({{app.globalData.windowHeight}}px - 930.526rpx - {{app.globalData.navBarHeight}}px - env(safe-area-inset-bottom) - 100rpx) / 2)" show-menu-by-longpress></image>
</view>

