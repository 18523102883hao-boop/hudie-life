.ec-page {
  width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

/* 导航栏 */
.nav-main::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
}
.ec-nav {
  width: 710rpx;
  align-items: center;
  justify-content: space-between;
  color: #000;
}
.ec-back {
  width: 48rpx;
  height: 48rpx;
}
.ec-back .iconfont {
  font-size: 36rpx;
  line-height: 48rpx;
  color: #333;
}
.ec-nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

/* 余额卡 */
.ec-wallet {
  width: 710rpx;
  margin: 20rpx auto 0;
  padding: 30rpx 30rpx 20rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background-image: linear-gradient(135deg, var(--brand-soft), var(--brand-border));
}
.ec-wallet-label {
  font-size: 24rpx;
  color: var(--brand-strong);
}
.ec-wallet-num {
  font-size: 68rpx;
  line-height: 84rpx;
  font-weight: 700;
  color: var(--brand-strong);
}
.ec-wallet-btns {
  margin-top: 16rpx;
}
.ec-wbtn {flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 26rpx;
  border: 1rpx solid var(--action);
  border-radius: 30rpx;
  margin-right: 16rpx;background:var(--action-background);color:#fff;}
.ec-wbtn:last-child {
  margin-right: 0;
}
.ec-wbtn-main {
  background:var(--action-background);
  border-color: var(--action);
  color: #fff;
}
.ec-wallet-tip {
  margin-top: 18rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: var(--brand-strong);
}

/* 区块 */
.ec-section {
  width: 710rpx;
  margin: 20rpx auto 0;
  padding: 20rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 20rpx;
}
.ec-sec-head {
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 16rpx;
}
.ec-sec-title {
  position: relative;
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  padding-left: 20rpx;
}
.ec-sec-title::after {
  position: absolute;
  content: '';
  left: 0;
  top: 6rpx;
  width: 8rpx;
  height: 28rpx;
  background: var(--brand);
}
.ec-sec-more {
  font-size: 24rpx;
  color: #999;
}
.ec-sec-more .iconfont {
  font-size: 20rpx;
  margin-left: 4rpx;
}

/* 空态 */
.ec-empty {
  padding: 60rpx 0;
  text-align: center;
}
.ec-empty-img {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.6;
}
.ec-empty-txt {
  font-size: 26rpx;
  color: #999;
  line-height: 40rpx;
}

/* 商品卡片（K1-5） */
.ec-goods-item {
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid #f2f2f2;
  align-items: flex-start;
}
.ec-goods-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f3f3f3;
  flex-shrink: 0;
}
.ec-goods-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}
.ec-goods-title {
  font-size: 28rpx;
  line-height: 40rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.ec-goods-price-line {
  margin-top: 10rpx;
  font-size: 24rpx;
}
.ec-goods-price {
  font-size: 28rpx;
  color: #fe3a00;
  font-weight: 700;
}
.ec-goods-sale {
  margin-left: 16rpx;
  color: #999;
  text-decoration: line-through;
}
.ec-goods-stat {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}
.ec-dot {
  margin: 0 8rpx;
}
.ec-goods-link {
  margin-left: 16rpx;
  color: var(--brand-strong);
  text-decoration: underline;
}
.ec-goods-act {
  margin-top: 12rpx;
  display: flex;
  justify-content: flex-end;
}
.ec-btn-export {
  min-width: 140rpx;
  height: 54rpx;
  line-height: 54rpx;
  padding: 0 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #fff;
  background:var(--action-background);
  border-radius: 27rpx;
}
.ec-btn-disabled {
  background: #ccc !important;
  color: #fff !important;
  text-decoration: none !important;
  font-size: 22rpx;
  min-width: 200rpx;
}

/* 搜索 */
.ec-search {
  align-items: center;
  padding: 0 8rpx 16rpx;
}
.ec-search-input {
  flex: 1;
  height: 64rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #333;
  background: #f5f5f5;
  border-radius: 32rpx;
  box-sizing: border-box;
}
.ec-search-ph {
  font-size: 26rpx;
  color: #bbb;
}
.ec-search-clear {margin-left: 12rpx;
  font-size: 24rpx;background:var(--action-background);color:#fff;}
.ec-search-btn {
  margin-left: 12rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  color: #fff;
  background:var(--action-background);
  border-radius: 32rpx;
}

/* 导出弹层 */
.ec-popup-sm {
  height: auto;
  padding-bottom: 30rpx;
}
.ec-export-body {
  padding: 24rpx 30rpx 0;
  box-sizing: border-box;
}
.ec-export-goods {
  font-size: 28rpx;
  line-height: 40rpx;
  color: #333;
  font-weight: 700;
  margin-bottom: 16rpx;
}
.ec-export-row {
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f7f7f7;
}
.ec-export-label {
  font-size: 26rpx;
  color: #666;
}
.ec-export-value {
  font-size: 26rpx;
  color: #333;
}
.ec-export-amount {
  font-size: 34rpx;
  font-weight: 700;
  color: #fe3a00;
}
.ec-stepper {
  align-items: center;
}
.ec-step-btn {width: 60rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 32rpx;
  border-radius: 8rpx;background:var(--action-background);color:#fff;}
.ec-step-disabled {
  color: #ccc;

  background:#f5f5f5;}
.ec-step-input {
  width: 120rpx;
  height: 56rpx;
  margin: 0 10rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
  background: #f5f5f5;
  border-radius: 8rpx;
}
.ec-export-warn {
  margin-top: 16rpx;
  padding: 16rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #d4380d;
  background: #fff2ee;
  border-radius: 10rpx;
}
.ec-export-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: #999;
}
.ec-export-submit {
  margin-top: 24rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 30rpx;
  color: #fff;
  background:var(--action-background);
  border-radius: 42rpx;
}

/* 余额明细弹层 */
.ec-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: #00000066;
  z-index: 1000;
}
.ec-popup {
  position: fixed;
  left: 0;
  bottom: 0;
  width: 750rpx;
  height: 70vh;
  background: #fff;
  border-radius: 20rpx 20rpx 0 0;
  z-index: 1001;
  display: flex;
  flex-direction: column;
}
.ec-popup-head {
  height: 96rpx;
  padding: 0 30rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f2f2f2;
}
.ec-popup-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}
.ec-popup-close {font-size: 26rpx;background:var(--action-background);color:#fff;}
.ec-popup-body {
  flex: 1;
  padding: 0 30rpx;
  box-sizing: border-box;
}
.ec-log-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f7f7f7;
  align-items: flex-start;
  justify-content: space-between;
}
.ec-log-left {
  flex: 1;
  padding-right: 20rpx;
}
.ec-log-type {
  font-size: 28rpx;
  color: #333;
}
.ec-log-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}
.ec-log-remark {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 32rpx;
}
.ec-log-right {
  text-align: right;
}
.ec-log-amount {
  font-size: 32rpx;
  font-weight: 700;
}
.ec-in {
  color: #fe3a00;
}
.ec-out {
  color: #333;
}
.ec-log-balance {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}
.ec-more {padding: 30rpx 0;
  text-align: center;
  font-size: 24rpx;background:var(--action-background);color:#fff;}
.ec-more-end {
  color: #ccc;
}

/* 状态筛选 tabs（K1-6） */
.ec-tabs {
  width: 710rpx;
  margin: 16rpx auto 0;
  align-items: center;
}
.ec-tab {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  margin-right: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  background: #fff;
  border-radius: 32rpx;
}
.ec-tab:last-child {
  margin-right: 0;
}
.ec-tab-on {
  color: #fff;
  background: var(--brand);
}

/* 按商品筛选提示 */
.ec-filter-tip {
  width: 710rpx;
  margin: 12rpx auto 0;
  padding: 12rpx 24rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  background: var(--brand-soft);
  border-radius: 12rpx;
}
.ec-filter-txt {
  font-size: 24rpx;
  color: var(--brand-strong);
}
.ec-filter-clear {
  font-size: 24rpx;
  color: var(--brand-strong);
}

/* 导出记录卡片（K1-6） */
.ec-rec-item {
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid #f2f2f2;
}
.ec-rec-head {
  align-items: center;
}
.ec-rec-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 10rpx;
  background: #f3f3f3;
  flex-shrink: 0;
}
.ec-rec-info {
  flex: 1;
  margin-left: 16rpx;
  min-width: 0;
}
.ec-rec-title {
  font-size: 27rpx;
  line-height: 38rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ec-rec-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}
.ec-rec-badge {
  margin-left: 12rpx;
  padding: 0 16rpx;
  height: 40rpx;
  line-height: 40rpx;
  font-size: 22rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}
/* 三态配色：未使用（待用）/ 已使用（完成）/ 已作废（失效） */
.ec-st-unused {
  color: #d4380d;
  background: #fff2ee;
}
.ec-st-used {
  color: #237804;
  background: #f0f9eb;
}
.ec-st-voided {
  color: #999;
  background: #f2f2f2;
}
.ec-rec-code-row {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  align-items: center;
  justify-content: space-between;
  background: var(--brand-soft);
  border: 1rpx dashed var(--brand-border);
  border-radius: 12rpx;
}
.ec-rec-code {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--brand-strong);
  font-family: Menlo, Consolas, monospace;
  word-break: break-all;
}
.ec-rec-copy {margin-left: 16rpx;
  font-size: 24rpx;
  flex-shrink: 0;background:var(--action-background);color:#fff;}
.ec-rec-foot {
  margin-top: 12rpx;
  align-items: center;
  justify-content: space-between;
}
.ec-rec-sub {
  flex: 1;
  font-size: 22rpx;
  color: #999;
}
.ec-rec-void {margin-left: 16rpx;
  padding: 0 20rpx;
  height: 48rpx;
  line-height: 48rpx;
  font-size: 22rpx;
  border: 1rpx solid var(--action);
  border-radius: 24rpx;background:var(--action-background);color:#fff;}
.ec-rec-reason {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #999;
}

/* 作废页（K1-7） */
.ec-void-tip {
  padding: 0 8rpx 16rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #999;
}
.ec-void-row {
  align-items: flex-start;
  justify-content: space-between;
  padding: 12rpx 8rpx 0;
}
.ec-void-label {
  font-size: 25rpx;
  color: #666;
  flex-shrink: 0;
}
.ec-void-value {
  flex: 1;
  margin-left: 24rpx;
  font-size: 25rpx;
  line-height: 36rpx;
  color: #333;
  text-align: right;
  word-break: break-all;
}
.ec-void-price {
  font-size: 28rpx;
  font-weight: 700;
  color: #fe3a00;
}
.ec-void-success {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #237804;
  background: #f0f9eb;
  border-radius: 12rpx;
}
.ec-void-hint {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #999;
  background: #f7f7f7;
  border-radius: 12rpx;
}
.ec-void-label-row {
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 12rpx;
}
.ec-void-count {
  font-size: 22rpx;
  color: #bbb;
}
.ec-void-textarea {
  width: 100%;
  height: 160rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  line-height: 40rpx;
  color: #333;
  background: #f7f7f7;
  border-radius: 12rpx;
}
.ec-void-btn {margin-top: 24rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 42rpx;background:var(--action-background);color:#fff;}

/* 提交与边界状态保持灰色，复制只改变可视按钮的按压底色。 */
.ec-more-loading{background:#ccc;color:#fff;}
.ec-copy-hover .ec-rec-copy{background:var(--action-pressed-background);}
