<view style="width: 710rpx;margin: 20rpx;">
  <view style="display: inline-block;font-size: 40rpx;font-weight: 700;">
    <view wx:if="{{info.status == 1}}" style="background: #fbfaf6;border-color: #f9f3e3;color: #fbe5b1;">待支付</view>
    <view wx:elif="{{info.status == 2}}" style="background: #f6ffed;border-color: #b7eb8f;color: #52c41a;">待使用</view>
    <view wx:elif="{{info.status == 20}}" style="background: #effbf2;border-color: #c3f7d2;color: #5fb878;">部分使用</view>
    <view wx:elif="{{info.status == 3}}" style="background: #fdf5f0;border-color: #ffd3be;color: #f66c2c;">已完成</view>
    <view wx:elif="{{info.status == 4}}" style="background: #fffde4;border-color: #fdf7a5;color: #ffee00;">已过期</view>
    <view wx:elif="{{info.status == 9}}" style="background: #fff1f0;border-color: #ffa39e;color: #f5222d;">已退款</view>
    <view wx:elif="{{info.status == -1}}" style="background: #ffffff;border-color: #f4f4f4;color: #333333;">已取消</view>
    <view wx:else style="background: #ffffff;border-color: #f4f4f4;color: #999;">未知</view>
  </view>
  <view style="width: 670rpx;margin-top: 20rpx;padding: 20rpx;background: #fff;display: flex;border-radius: 20rpx;justify-content: space-between;">
    <view style="width: 250rpx;">
      <image src="{{info.goods.imgs[0]}}" style="width: 250rpx;height: 200rpx;border-radius: 20rpx;"></image>
    </view>
    <view style="width: 400rpx;">
      <view style="line-height: 40rpx;height: 120rpx;font-weight: 700;display: -webkit-box;-webkit-box-orient: vertical;-webkit-line-clamp: 3;overflow: hidden;text-overflow: ellipsis;">{{info.goods.title}}</view>
      <view style="height: 60rpx;margin-top: 20rpx">
        <text style="font-size: 30rpx;color: #fe0a0a;">优惠价</text>
        <text style="font-size: 36rpx;color: #fe0a0a;">￥{{info.goods.price}} </text>
        <text style="font-size: 24rpx;color: #777;text-decoration: line-through;"> 门市价￥{{info.goods.market_price}}</text>
      </view>
    </view>
  </view>
  <view style="width: 670rpx;margin-top: 20rpx;padding: 20rpx;background: #fff;border-radius: 20rpx;font-size: 30rpx;">
    <view style="width: 670rpx;display: flex;justify-content: space-between;line-height: 50rpx;border-bottom: 1rpx solid #f1f1f1;padding-bottom: 20rpx;margin-bottom: 20rpx;">
      <view>券码</view>
    </view>
    <view catchtap="selCode" data-item="{{item}}" data-index="{{index}}" wx:for="{{info.code}}" wx:key="index" style="display:flex;justify-content: space-between;{{info.code.length == index+1 ? '' : 'border-bottom: 1rpx solid #f1f1f1;padding-bottom: 20rpx;margin-bottom: 20rpx;'}}">
      <view style="display: flex;justify-content: space-between;line-height: 40rpx;">
        <view style="{{item.verify_time?'color:#999;text-decoration: line-through;':'color:#000;'}}"><text class="icon iconfont icon-success{{item.is_sel ? '-fill' : ''}}" style="color: {{item.is_sel ? 'var(--brand-strong)' : '#999'}};"></text> {{item.code}}</view>
      </view>
      <view wx:if="{{item.verify_time}}" style="line-height: 30rpx;font-size: 24rpx;margin-top: 10rpx;">
        <view style="color: #999;">{{item.verify_time}}</view>
      </view>
    </view>
  </view>
  <view style="width: 670rpx;margin-top: 20rpx;padding: 20rpx;background: #fff;border-radius: 20rpx;font-size: 30rpx;">
    <view style="width: 670rpx;display: flex;justify-content: space-between;line-height: 50rpx;border-bottom: 1rpx solid #f1f1f1;padding-bottom: 20rpx;margin-bottom: 20rpx;">
      <view>核销门店</view>
      <view style="font-size: 24rpx;" wx:if="{{store_list.length > 1}}">{{store_list.length}}家店适用<text class="icon iconfont icon-right"></text></view>
    </view>
    <view catchtap="selStore" data-item="{{item}}" wx:for="{{store_list}}" wx:key="index" style="{{store_list.length == index+1 ? '' : 'border-bottom: 1rpx solid #f1f1f1;padding-bottom: 20rpx;margin-bottom: 20rpx;'}}">
      <view style="display: flex;justify-content: space-between;line-height: 40rpx;">
        <view style="width: 670rpx;color:{{item.disabled?'#999':'#000'}};"><text class="icon iconfont icon-success{{store.id == item.id ? '-fill' : ''}}" style="color: {{store.id == item.id ? 'var(--brand-strong)' : '#999'}};"></text> {{item.name}}</view>
      </view>
      <view style="display: flex;justify-content: space-between;line-height: 30rpx;font-size: 24rpx;margin-top: 10rpx;">
        <view catchtap="daohang" data-item="{{item}}" style="width: 670rpx;background:var(--action-background);color:#fff;" hover-class="theme-action-hover">{{item.province}} {{item.city}} {{item.county}} {{item.address}}</view>
      </view>
    </view>
  </view>
  <view style="width: 670rpx;margin-top: 20rpx;padding: 20rpx;background: #fff;border-radius: 20rpx;font-size: 30rpx;">
    <view style="width: 670rpx;line-height: 50rpx;margin-bottom: 10rpx;">
      <view style="font-weight: 700;">订单信息</view>
    </view>
    <view style="display: flex;justify-content: space-between;line-height: 50rpx;">
      <view style="color: #666;width: 160rpx;">订 单 号</view>
      <view style="width: 510rpx;">{{info.no}}</view>
    </view>
    <view style="display: flex;justify-content: space-between;line-height: 50rpx;">
      <view style="color: #666;width: 160rpx;">用户昵称</view>
      <view style="width: 510rpx;">{{info.name}}</view>
    </view>
    <view style="display: flex;justify-content: space-between;line-height: 50rpx;">
      <view style="color: #666;width: 160rpx;">用户电话</view>
      <view style="width: 510rpx;">{{info.mobile}}</view>
    </view>
    <view style="display: flex;justify-content: space-between;line-height: 50rpx;color: #fe0a0a;" wx:if="{{info.refund_date}}">
      <view style="color: #666;width: 160rpx;">退款时间</view>
      <view style="width: 510rpx;">{{info.refund_date}}</view>
    </view>
    <view style="display: flex;justify-content: space-between;line-height: 50rpx;color: #fe0a0a;" wx:if="{{info.finish_date}}">
      <view style="color: #666;width: 160rpx;">完成时间</view>
      <view style="width: 510rpx;">{{info.finish_date}}</view>
    </view>
    <view style="display: flex;justify-content: space-between;line-height: 50rpx;" wx:if="{{info.pay_date}}">
      <view style="color: #666;width: 160rpx;">支付时间</view>
      <view style="width: 510rpx;">{{info.pay_date}}</view>
    </view>
    <view style="display: flex;justify-content: space-between;line-height: 50rpx;">
      <view style="color: #666;width: 160rpx;">下单时间</view>
      <view style="width: 510rpx;">{{info.add_date}}</view>
    </view>
    <view style="width: 100%;height: 1px;background: #f1f1f1;margin: 10rpx 0"></view>
    <view style="display: flex;justify-content: space-between;line-height: 50rpx;">
      <view style="color: #666;width: 160rpx;">购买份数</view>
      <view style="width: 510rpx;">{{info.num}}份</view>
    </view>
  </view>
</view>

<view wx:if="{{show_msg}}" style="position: fixed;left: 0;top: 0;background: #00000066;z-index: 9;width: 100%;height: 100%;">
  <view style="position: absolute;height: 420rpx;width: 650rpx;left: 50rpx;background: #fff;top: calc(50vh - 420rpx);border-radius: 20rpx;">
    <view style="line-height: 80rpx;font-size: 40rpx;text-align: center;font-weight: 700;margin: 40rpx 0 0;">核销门店</view>
    <view style="line-height: 60rpx;font-size: 50rpx;color: var(--brand-strong);font-weight: 700;text-align: center;margin-top: 20rpx;display: -webkit-box;-webkit-box-orient: vertical;-webkit-line-clamp: 1;overflow: hidden;text-overflow: ellipsis;">{{store.name}}</view>
    <view style="line-height: 40rpx;font-size: 36rpx;color: #ed2519;font-weight: 700;text-align: center;margin-top: 20rpx;display: -webkit-box;-webkit-box-orient: vertical;-webkit-line-clamp: 1;overflow: hidden;text-overflow: ellipsis;">核销{{num}}份</view>
    <view style="display: flex;justify-content: space-between;text-align: center;margin-top: 60rpx;">
      <view style="width: 50%;">
        <view catchtap="hideMsg" style="width: 70%;margin-left: 15%;line-height: 60rpx;border: 1px solid #ccc;border-radius: 20rpx;background:var(--action-background);color:#fff;" hover-class="theme-action-hover">取消</view>
      </view>
      <view style="width: 50%;">
        <view catchtap="doVerify" style="width: 70%;margin-left: 15%;line-height: 60rpx;border: 1px solid var(--action);border-radius: 20rpx;background:var(--action-background);color:#fff;" hover-class="theme-action-hover">确认核销</view>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{info.status == 2 || info.status == 4 || info.status == 20}}" catchtap="showMsg" style="width: 750rpx;line-height: 80rpx;text-align: center;position: fixed;bottom: 0;border-bottom: calc(env(safe-area-inset-bottom)) solid #f1f1f1;background:var(--action-background);color:#fff;" hover-class="theme-action-hover">立即核销({{num}})</view>
<view wx:elif="{{info.status == 3}}" style="width: 750rpx;line-height: 80rpx;background: #ccc;color: #fff;text-align: center;position: fixed;bottom: 0;border-bottom: calc(env(safe-area-inset-bottom)) solid #f1f1f1;">已核销
  <text wx:if="{{info.status==2 || info.status==20 || info.status==4}}">（{{info.verify_date}}）</text>
</view>
<view style="width: 1rpx;height: calc(env(safe-area-inset-bottom) + 80rpx);"></view>