<view class="points flex">
  <view class="{{nav_index == index ?'pointe':'point'}}" wx:for="{{2}}" wx:key="index">
  </view>
</view>

<view wx:if="{{new_list.length > 0}}" style="width: 710rpx;display: flex;margin: 10rpx 20rpx 20rpx;justify-content: space-between;color: #fff7ea;">
  <view style="width: 325rpx;background: var(--brand-strong);padding: 20rpx;border-radius: 20rpx;line-height: 36rpx;">
    <view style="display: flex;justify-content: space-between;line-height: 36rpx;">
      <view style="font-weight: 700;font-size: 24rpx;line-height: 30rpx;letter-spacing: 2rpx;">
        <image src="{{app.domain}}static/img/hg.png" mode="aspectFit" style="width: 27rpx;height: 30rpx;vertical-align: middle;margin-right: 6rpx;"></image>
        爆品排行榜
      </view>
      <view hover-class="theme-action-hover" data-path="/pages/goods_group/top" bindtap="switchTab" style="font-size: 24rpx;line-height: 30rpx;padding: 0 15rpx;border-radius: 20rpx;background:var(--action-background);color:#fff;">more</view>
    </view>
    <view style="margin: 20rpx 0 0;height: 140rpx;">
      <view style="width: 310rpx;height: 156rpx;position: relative;left: 10rpx;">
        <view style="width: 290rpx;height: 136rpx;background-image: url({{top_goods.img}});background-size: 100% 100%;filter: blur(5px);position: absolute;left: 10rpx;top: 10rpx;"></view>
        <image src="{{top_goods.img}}" mode="aspectFit" style="width: 310rpx;height: 156rpx;position: absolute;z-index: 1;top: 0;left: 0;"></image>
        <!-- <view style="font-size: 20rpx;line-height: 32rpx;width: 340rpx;position: absolute;bottom: 0;left: 0;background: #ffffffaa;display: -webkit-box;-webkit-box-orient: vertical;-webkit-line-clamp: 1;overflow: hidden;text-overflow: ellipsis;">{{top_goods.title}}</view> -->
        <view style="font-size: 24rpx;width: 80rpx;text-align: center;font-weight: 700;background: var(--brand-strong);color: #fff;position: absolute;top: 0;right: 10rpx;border-radius: 0 0 10rpx 10rpx;z-index: 1;">TOP 1</view>
      </view>
      <!-- <image src="{{top_goods.img}}" style="width: 305rpx;height: {{305/top_goods.img_size.width*top_goods.img_size.height}}rpx;border-radius: 20rpx;margin-top: 15rpx;"></image> -->
    </view>
  </view>
  <view style="width: 285rpx;background: var(--brand-strong);padding: 20rpx;border-radius: 20rpx;position: relative;">
    <view style="width: 58rpx;height: 57rpx;position: absolute;left: -2rpx;top: -2rpx;z-index: 1;background: var(--brand-strong);color: #fff;font-size: 18rpx;line-height: 57rpx;text-align: center;border-radius: 10rpx 0 16rpx 0;">NEW</view>
    <view style="display: flex;justify-content: space-between;line-height: 36rpx;">
      <view style="font-weight: 700;font-size: 24rpx;line-height: 30rpx;text-indent: 30rpx;letter-spacing: 2rpx;">
        <!-- <view style="background: #fff;display: inline-block;background:var(--action-background);color: #fff;font-size: 24rpx;padding: 0 8rpx;border-radius: 10rpx;">{{date}}</view> -->
        今日上新
      </view>
      <view hover-class="theme-action-hover" data-path="/pages/goods_group/new" bindtap="switchTab" style="font-size: 24rpx;line-height: 30rpx;padding: 0 15rpx;border-radius: 20rpx;background:var(--action-background);color:#fff;">more</view>
    </view>
    <view style="width: 100%;overflow-x: scroll;">
      <view style="margin-top: 20rpx;width: calc(176rpx * {{new_list.length}} - 20rpx);">
        <view style="width: 156rpx;display: inline-block;margin-right: {{new_list.length == index+1 ? '0' : '20rpx'}};" wx:for="{{new_list}}" wx:key="index" catchtap="viewGoods" data-id="{{item.id}}">
          <view style="width: 156rpx;height: 156rpx;position: relative;">
            <view style="width: 136rpx;height: 136rpx;background-image: url({{item.img}});background-size: 100% 100%;filter: blur(5px);margin: 10rpx;"></view>
            <image src="{{item.img}}" mode="aspectFit" style="width: 156rpx;height: 156rpx;position: absolute;z-index: 1;top: 0;left: 0;"></image>
          </view>
          <!-- <image src="{{item.img}}" style="width: 200rpx;height: {{200/item.img_size.width*item.img_size.height}}rpx;border-radius: 20rpx;"></image> -->
          <!-- <view style="font-size: 24rpx;display: -webkit-box;-webkit-box-orient: vertical;-webkit-line-clamp: 1;overflow: hidden;text-overflow: ellipsis;">{{item.title}}</view> -->
          <!-- <view style="font-size: 24rpx;color: #fe0a0a;font-weight: 700;">￥{{item.subsidy_price}}</view> -->
        </view>
      </view>
    </view>
  </view>
</view>

<view>
  <view style="width: 670rpx;padding: 20rpx;margin: 20rpx 20rpx 0;background: #fff;border-radius: 20rpx;display: flex;justify-content: space-between;" wx:for="{{list}}" wx:key="index" catchtap="viewGoods" data-id="{{item.id}}">
    <view style="width: 200rpx;height: 200rpx;position: relative;">
      <view style="width: 180rpx;height: 180rpx;background-image: url({{item.img}});background-size: 100% 100%;filter: blur(5px);margin: 10rpx"></view>
      <image src="{{item.img}}" mode="aspectFit" style="width: 200rpx;height: 200rpx;position: absolute;z-index: 1;top: 0;left: 0;"></image>
    </view>
    <view style="width: 450rpx;height: 200rpx;position: relative;">
      <view style="font-size: 30rpx;font-weight: 700;display: -webkit-box;-webkit-box-orient: vertical;-webkit-line-clamp: 1;overflow: hidden;text-overflow: ellipsis;line-height: 40rpx;height: 40rpx;">{{item.title}}</view>
      <view style="display: flex;font-size: 21rpx;flex-wrap: wrap;">
        <view style="color: #fdb067;background: #fef6eb;line-height: 30rpx;padding: 0 10rpx;border-radius: 10rpx;margin-right: 6rpx;margin-top: 6rpx;" wx:if="{{item.commission}}">优选补贴 {{item.commission}}</view>
        <view style="color: #fdb067;background: #fef6eb;line-height: 30rpx;padding: 0 10rpx;border-radius: 10rpx;margin-right: 6rpx;margin-top: 6rpx;" wx:for="{{item.tag}}" wx:key="i_tag" wx:for-item="tag">{{tag}}</view>
      </view>
      <view style="display: flex;justify-content: space-between;font-size: 24rpx;color: #999;line-height: 50rpx;flex-wrap: wrap;position: absolute;bottom: 0">
        <view style="width: 300rpx;">
          <view style="font-weight: 700;color: #ff3d24;width: 300rpx;">
            <text style="font-weight: 100;">当前价</text> ￥<text style="font-size: 44rpx;">{{item.subsidy_price}} </text>
          </view>
          <view style="width: 300rpx;line-height: 20rpx;font-size: 20rpx;display: flex;">
            <text style="color: #777;text-decoration: line-through;font-weight: 100;">门市价￥{{item.market_price}}</text>
            <text class="icon iconfont icon-location" style="margin-left: 20rpx;">{{item.distant}}</text>
          </view>
        </view>
        <view style="width: 150rpx;position: relative;">
          <view style="position: absolute;width: 120rpx;bottom: 50rpx;right: 0;line-height: 30rpx;background: var(--brand-soft);text-align: center;color: var(--brand-strong);border-radius: 10rpx 10rpx 0 0;padding-bottom: 10rpx;"><text class="icon iconfont icon-view-fill">{{item.view_num}}</text></view>
          <view wx:if="{{item.status!=1}}" style="line-height: 60rpx;background-image: linear-gradient(to bottom right, #cacaca, #dadada);color: #fff;width: 120rpx;text-align: center;border-radius: 10rpx;position: absolute;bottom: 0;right: 0;">{{item.start_time <= now_time ? '已下架' : '未上架'}}</view>
          <view wx:elif="{{item.end_time<now_time}}" style="line-height: 60rpx;background-image: linear-gradient(to bottom right, #cacaca, #dadada);color: #fff;width: 120rpx;text-align: center;border-radius: 10rpx;position: absolute;bottom: 0;right: 0;">已下架</view>
          <view wx:elif="{{item.start_time>now_time}}" style="line-height: 60rpx;background: #ffaa00;color: #fff;width: 120rpx;text-align: center;border-radius: 10rpx;position: absolute;bottom: 0;right: 0;">未开售</view>
          <view wx:elif="{{item.stock<=0}}" style="line-height: 60rpx;background-image: linear-gradient(to bottom right, #cacaca, #dadada);color: #fff;width: 120rpx;text-align: center;border-radius: 10rpx;position: absolute;bottom: 0;right: 0;">已抢光</view>
          <view hover-class="theme-action-hover" wx:else style="line-height: 60rpx;background:var(--action-background);color: #fff;width: 120rpx;text-align: center;border-radius: 10rpx;position: absolute;bottom: 0;right: 0;">
            <text>{{item.group_num}}人团</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{0}}" style="width: 670rpx;padding: 20rpx;margin: 20rpx 20rpx 0;background: #fff;border-radius: 20rpx;display: flex;justify-content: space-between;" wx:for="{{list}}" wx:key="index" catchtap="viewGoods" data-id="{{item.id}}">
    <view style="width: 200rpx;height: 200rpx;position: relative;">
      <view style="width: 200rpx;height: 200rpx;background-image: url({{item.img}});background-size: 100% 100%;filter: blur(5px);"></view>
      <image src="{{item.img}}" mode="aspectFit" style="width: 200rpx;height: 200rpx;position: absolute;z-index: 1;top: 0;left: 0;"></image>
    </view>
    <view style="width: 450rpx;height: 200rpx;">
      <view style="font-size: 30rpx;font-weight: 700;display: -webkit-box;-webkit-box-orient: vertical;-webkit-line-clamp: 2;overflow: hidden;text-overflow: ellipsis;line-height: 40rpx;height: 80rpx;">{{item.title}}</view>
      <view style="display: flex;justify-content: space-between;font-size: 24rpx;color: #999;line-height: 34rpx;">
        <view><text class="icon iconfont icon-view-fill"> {{item.view_num}}</text></view>
        <view>{{item.distant}}</view>
      </view>
      <view style="display: flex;justify-content: space-between;font-size: 24rpx;line-height: 36rpx;">
        <view style="color: #fb7627;border: 1px solid #fb7627;padding: 0 20rpx;border-radius: 10rpx;">分享得{{item.commission}}</view>
      </view>
      <view style="display: flex;justify-content: space-between;font-size: 24rpx;color: #999;line-height: 50rpx;">
        <view style="font-weight: 700;color: #fe0a0a;">
          ￥<text style="font-size: 40rpx;">{{item.subsidy_price}} </text>
          <text style="color: #777;text-decoration: line-through;font-weight: 100;">门市价￥{{item.market_price}}</text>
        </view>
        <view hover-class="theme-action-hover" style="width: 100rpx;background:var(--action-background);color: #fff;text-align: center;border-radius: 25rpx;">{{item.group_num}}人团</view>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{show_customer}}" style="position: fixed;width: 100%;height: 100%;left: 0;top: 0;background: #00000066;z-index: 99;">
  <image src="{{customer.img}}" style="width: 550rpx;height: 550rpx;position: absolute;left: 100rpx;top: calc(50vh - 275rpx - env(safe-area-inset-bottom) - 100rpx);" show-menu-by-longpress></image>
  <view catchtap="hideCustomer" style="position: absolute;width: 60rpx;height: 60rpx;line-height: 60rpx;text-align: center;font-size: 40rpx;border-radius: 50%;border: 2rpx solid #fff;color: #fff;top: calc(50vh + 275rpx - env(safe-area-inset-bottom) - 100rpx + 40rpx);left: 345rpx;"><text class="icon iconfont icon-x"></text></view>
</view>
