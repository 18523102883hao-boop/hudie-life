<swiper style="width: 750rpx;height: 1333.3333rpx;" autoplay="play" circular interval="5000" bindchange="swiperchange">
  <swiper-item wx:for="{{qrcode}}" wx:key="index" class="luns" data-item="{{item}}">
    <image mode="widthFix" src="{{item}}"></image>
  </swiper-item>
</swiper>

<view style="width: 750rpx;background: #f1f1f1;height: calc(env(safe-area-inset-bottom) + 100rpx)"></view>
<view wx:if="{{qrcode.length > 0}}" style="position: fixed;bottom: calc(env(safe-area-inset-bottom));width: 750rpx;height: 100rpx;">
  <view hover-class="theme-action-hover" style="width: 243.3333rpx;height: 80rpx;position: absolute;right: 87.7777rpx;bottom: 10rpx;background:var(--action-background);color: #fff;text-align: center;line-height: 80rpx;border-radius: 40rpx;border: 0;" catchtap="shareImg">分享图片</view>

  <view hover-class="theme-action-hover" style="width: 243.3333rpx;height: 80rpx;position: absolute;left: 87.7777rpx;bottom: 10rpx;background:var(--action-background);color: #fff;text-align: center;line-height: 80rpx;border-radius: 40rpx;border: 0;" catchtap="saveImg">保存图片</view>
</view>