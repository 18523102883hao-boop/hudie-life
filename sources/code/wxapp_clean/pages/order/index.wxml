<view style="display: flex;text-align: center;line-height: 60rpx;font-size: 30rpx;">
  <view style="width: 20%;" catchtap="selIndex" data-index="0">
    <view style="display: inline-block;margin: 0 auto;{{index==0?'border-bottom: 8rpx solid var(--brand-strong);color: var(--brand-strong);font-weight: 700;':''}}">全部</view>
  </view>
  <view style="width: 20%;" catchtap="selIndex" data-index="1">
    <view style="display: inline-block;margin: 0 auto;{{index==1?'border-bottom: 8rpx solid var(--brand-strong);color: var(--brand-strong);font-weight: 700;':''}}">待付款</view>
  </view>
  <view style="width: 20%;" catchtap="selIndex" data-index="21">
    <view style="display: inline-block;margin: 0 auto;{{index==21?'border-bottom: 8rpx solid var(--brand-strong);color: var(--brand-strong);font-weight: 700;':''}}">拼团中</view>
  </view>
  <view style="width: 20%;" catchtap="selIndex" data-index="2">
    <view style="display: inline-block;margin: 0 auto;{{index==2?'border-bottom: 8rpx solid var(--brand-strong);color: var(--brand-strong);font-weight: 700;':''}}">待使用</view>
    </view>
  <view style="width: 20%;" catchtap="selIndex" data-index="3">
    <view style="display: inline-block;margin: 0 auto;{{index==3?'border-bottom: 8rpx solid var(--brand-strong);color: var(--brand-strong);font-weight: 700;':''}}">已完成</view>
  </view>
</view>

<view catchtap="viewOrder" data-item="{{item}}" wx:for="{{list}}" wx:key="index" style="width: 670rpx;margin: 20rpx;background: #fff;padding: 20rpx;border-radius: 20rpx;">
  <view style="display: flex;justify-content: space-between;line-height: 40rpx;">
    <view style="font-size: 24rpx;font-weight: 700;">订单号：{{item.no}} <text class="icon iconfont icon-right"></text></view>
    <view style="font-size: 30rpx;">
      <view wx:if="{{item.status == 1}}" style="background: #fbfaf6;border-color: #f9f3e3;color: #fbe5b1;">待支付</view>
      <view wx:elif="{{item.status == 2}}" style="background: #f6ffed;border-color: #b7eb8f;color: #52c41a;">待使用</view>
      <view wx:elif="{{item.status == 20}}" style="background: #effbf2;border-color: #c3f7d2;color: #5fb878;">部分使用</view>
      <view wx:elif="{{item.status == 21}}" style="background: #f5f2e0;border-color: #f1e8b4;color: #b1644c;">拼团中</view>
      <view wx:elif="{{item.status == 3}}" style="background: #fdf5f0;border-color: #ffd3be;color: #f66c2c;">已完成</view>
      <view wx:elif="{{item.status == 4}}" style="background: #fffde4;border-color: #fdf7a5;color: #ffee00;">已过期</view>
      <view wx:elif="{{item.status == 90}}" style="background: #f7eeed;border-color: #f5bab5;color: #e63e30;">退款处理中</view>
      <view wx:elif="{{item.status == 9}}" style="background: #fff1f0;border-color: #ffa39e;color: #f5222d;">已退款</view>
      <view wx:elif="{{item.status == -1}}" style="background: #ffffff;border-color: #f4f4f4;color: #333333;">已取消</view>
      <view wx:else style="background: #ffffff;border-color: #f4f4f4;color: #999;">未知</view>
    </view>
  </view>
  <view style="display: flex;width: 670rpx;margin-top: 20rpx;align-items: stretch;">
    <view style="width: 200rpx;height: 200rpx;">
      <image src="{{item.order.imgs[0]}}" style="width: 100%;height: 100%;border-radius: 20rpx;"></image>
    </view>
    <view style="width: 460rpx;margin-left: 10rpx;font-size: 28rpx;color: #555;">
      <view style="font-weight: 700;color: #111;">{{item.order.shop_name}}</view>
      <view style="line-height: 38rpx;display: -webkit-box;-webkit-box-orient: vertical;-webkit-line-clamp: 2;overflow: hidden;text-overflow: ellipsis;height: 76rpx;">{{item.order.title}}</view>
      <view style="font-size: 24rpx;margin: 4rpx 0;display: flex;justify-content: space-between;" wx:if="{{item.order.refund_time}}"><view>退款时间：</view><view>{{item.order.refund_time}}</view></view>
      <view style="font-size: 24rpx;margin: 4rpx 0;" wx:else>
        <block wx:if="{{item.order.verify_time}}">
          <view>消费时间：</view><view>{{item.order.verify_time}}</view>
        </block>
        <view wx:else>⠀</view>
      </view>
      <view style="font-size: 34rpx;color: #fe0a0a;font-weight: 700;text-align: right;"><text style="font-size: 24rpx;">￥</text>{{item.order.amount}}</view>
    </view>
  </view>
</view>

<import src="/utils/common/loading"></import>
<template is="loading" data="{{app,loading,list}}"></template>
