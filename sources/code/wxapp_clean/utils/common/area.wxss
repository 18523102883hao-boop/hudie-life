.box{box-sizing:border-box;position: fixed;left: 0;top: 0;width: 100%;height: 100%;background: #f1f1f1;z-index: 99999;}
.title{font-weight:600}
.city{height:80rpx;line-height:80rpx;font-size:28rpx;border-bottom:1rpx solid #aaaaaa}
.title:last-child{margin-top:20rpx}
.main{padding:20rpx 0;box-sizing:border-box}
.item-one{box-sizing:border-box;width:30%;min-width:0;padding: 0 10rpx;height:70rpx;background-color:#fff;border-radius:20rpx;text-align:center;line-height:70rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;}
.items-one{box-sizing:border-box;width:30%;min-width:0;padding: 0 10rpx;height:70rpx;background-color:var(--brand-strong);border-radius:20rpx;text-align:center;line-height:70rpx;color:#ffffff;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;}