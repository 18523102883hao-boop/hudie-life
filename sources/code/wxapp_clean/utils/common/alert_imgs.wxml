<template name="alert_imgs">
<view wx:if="{{showAlert}}" style="position: fixed;width: 100%;height: 100%;left: 0;top: 0;background: #00000066;z-index: 99;">
  <swiper autoplay="play" circular interval="3000" style="width: 560rpx;height: 700rpx;position: absolute;left: 95rpx;top: calc(50vh - 350rpx - env(safe-area-inset-bottom) - 100rpx);">
    <swiper-item wx:for="{{alertList}}" wx:key="index" bindtap="toPage" data-item="{{item}}" style="width: 100%;height: 100%;">
      <image src="{{item.img}}" style="border-radius: 20rpx;width: 100%;height: 100%;" show-menu-by-longpress></image>
    </swiper-item>
  </swiper>
  <view catchtap="hideAlert" style="position: absolute;width: 60rpx;height: 60rpx;line-height: 60rpx;text-align: center;font-size: 40rpx;border-radius: 50%;border: 2rpx solid #fff;color: #fff;top: calc(50vh + 350rpx - env(safe-area-inset-bottom) - 100rpx + 40rpx);left: 345rpx;"><text class="icon iconfont icon-x"></text></view>
</view>
</template>