page{background-color:#f6f6f6;color:#272733}
.boxse{min-height:100vh;box-sizing:border-box;padding-bottom:calc(40rpx + env(safe-area-inset-bottom));background:linear-gradient(var(--brand-soft) 0,var(--brand-soft) 340rpx,#f6f6f6 560rpx)}
.views{width:48rpx;height:48rpx;color:var(--brand-strong)}
.views image{width:100%;height:100%}
.viewesss{width:750rpx;justify-content:space-between;color:#272733}
.avatar-wrapper{width:180rpx;height:180rpx;padding:0rpx;box-sizing:border-box;border:4rpx solid #fff;border-radius:50%;overflow:hidden;background:var(--brand-border);box-shadow:0 12rpx 30rpx #2020370a}
.avatar{width:180rpx;height:180rpx}
.view input{flex:1;text-align:center;padding-right:11vw;box-sizing:border-box}
.btn{width:350rpx;background:var(--action-background);border-radius:44rpx;text-align:center;line-height:80rpx;margin:0 auto;margin-top:200rpx;color:#fff;font-weight:600;box-shadow:0 8rpx 24rpx rgba(22,140,240,0.10)}
.logo{width:200rpx;height:300rpx;margin:0 auto}
.logo image{width:200rpx;height:300rpx}
.TipsImg{width:36rpx;height:36rpx;margin-right:10rpx}
.TipsImg image{width:100%;height:100%}
.TipsTxt{flex:1;font-size:28rpx;line-height:45rpx;font-weight:500;letter-spacing:2rpx;text-align:center}
.input{width:630rpx;height:100rpx;background:#fff;border-radius:20rpx 20rpx 20rpx 20rpx;opacity:1;border:2rpx solid var(--brand-border)}
.input{align-items:center}
.input1{width:2rpx;height:24rpx;background-color:var(--brand-border);margin:0 26rpx}
.input2{flex:1;font-size:28rpx;font-family:PingFang SC-Regular,PingFang SC;font-weight:400;color:#888888}
.input2 input{width:100%;height:100%;letter-spacing:5rpx;font-size:14px;color:#272733;text-align:center;caret-color:var(--brand-strong)}
.input3{width:48rpx;height:48rpx;color:var(--brand-strong)}
.input3 image{width:48rpx;height:48rpx}
.van-button--info{background:#fff !important;border-color:#fff !important;color:#333 !important;padding:0 !important;width:100% !important}
.phone-row{position:relative;margin-top:28rpx}
.phone-number{min-width:0;font-size:14px;letter-spacing:5rpx;text-align:center;color:#272733}
.phone-placeholder{color:#888888}
.phone-arrow{text-align:center;line-height:48rpx;font-size:40rpx;font-weight:300}
.phone-button{position:absolute;inset:0;width:100%;height:100%;margin:0;padding:0;border-radius:20rpx;background:transparent;color:var(--brand-strong)}
.phone-button::after{border:none}
.phone-button[disabled],.phone-button.button-hover{background:transparent}


.phone-row{background:var(--action-background);}
.phone-row .phone-number,.phone-row .phone-arrow,.phone-row .input1{color:#fff;}
.phone-row.phone-row-disabled{background:#eee;}
.phone-row-disabled .phone-number,.phone-row-disabled .phone-arrow{color:#999;}
