page{background:#ffffff}
.view{width:48rpx;height:48rpx}
.view image{width:100%;height:100%}
.bgc{width:100%;height:510rpx;top:0;left:0;z-index:-1;background-color:var(--brand-strong)}
.logo{width:670rpx;height:240rpx;font-size:108rpx;font-family:PingFang SC-Regular,PingFang SC;font-weight:400;color:var(--brand-strong);margin:0 auto;margin-top:132rpx;text-align:center;padding-top:100rpx;box-sizing:border-box}
.name_img{width:60rpx;height:60rpx;text-align: center;line-height: 60rpx;font-size: 44rpx;}
.name{width:630rpx;height:108rpx;background:#fff;border-radius:20rpx;opacity:1;margin-top:128rpx;margin-left:60rpx;padding:24rpx 22rpx;box-sizing:border-box;align-items:center;border-bottom:2rpx solid #eeeeee}
.names{width:630rpx;height:108rpx;background:#fff;border-radius:20rpx;opacity:1;margin-left:60rpx;padding:24rpx 22rpx;box-sizing:border-box;align-items:center;border-bottom:2rpx solid #eeeeee}
.name_img image{width:100%;height:100%}
.name_input{padding-left:18rpx;box-sizing:border-box;font-size:28rpx;font-family:PingFang SC-Regular,PingFang SC;font-weight:400;color:#AAAAAA}
.name:nth-of-type(2){margin-top:20rpx}
.ji_img{width:60rpx;height:60rpx}
.ji_img image{width:100%;height:100%}
.ji_password{align-items:center;margin-top:22rpx;margin-left:60rpx}
.submit{margin:0 auto;margin-top:190rpx;width:632rpx;height:90rpx;background:var(--action-background);border-radius:50rpx;opacity:1;text-align:center;line-height:90rpx;font-size:32rpx;font-family:PingFang SC-Regular,PingFang SC;font-weight:400;color:#fff;letter-spacing:5rpx}