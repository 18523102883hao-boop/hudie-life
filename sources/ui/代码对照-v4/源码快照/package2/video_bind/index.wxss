page {
  background: #f6f6f6;
  color: #30303a;
}
.page {
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
}
.notice {
  padding: 26rpx;
  border-radius: 18rpx;
  background: #fff0df;
  color: #9d7043;
  line-height: 1.8;
  font-size: 25rpx;
  margin-bottom: 24rpx;
}
.card {
  padding: 32rpx;
  background: #fff;
  border-radius: 22rpx;
}
.title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 30rpx;
}
.video-id-label {
  font-size: 28rpx;
  margin: 28rpx 0 16rpx;
}
.input {
  height: 92rpx;
  line-height: 92rpx;
  border: 1rpx solid var(--brand-border);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 27rpx;
}
.hint {
  font-size: 23rpx;
  color: #999;
  line-height: 1.8;
  margin: 20rpx 0;
}
.current {
  font-size: 27rpx;
  line-height: 1.8;
  word-break: break-all;
  color: var(--brand-strong);
}
.primary,
.secondary {
  font-size: 28rpx;
  border-radius: 50rpx;
  margin-top: 30rpx;
}
.primary {
  background:var(--action-background);
  color: #fff;
}
.secondary {
  background: var(--action-background);
  color: #fff;
}
.error {
  color: #bc553e;
  font-size: 25rpx;
  margin-top: 26rpx;
  line-height: 1.7;
}

.primary[disabled], .secondary[disabled] { background: #eee; color: #999; }

