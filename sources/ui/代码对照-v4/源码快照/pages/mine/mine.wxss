page {
  background: #f6f6f6;
  color: #272733;
}
.mine-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 24rpx calc(150rpx + env(safe-area-inset-bottom));
  background: linear-gradient(var(--brand-border) 0, var(--brand-soft) 340rpx, #f6f6f6 560rpx);
}
.nav-main {
  position: relative;
}
.nav-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
}
.profile {
  display: flex;
  align-items: center;
  padding: 30rpx 10rpx 36rpx;
  gap: 24rpx;
}
.avatar {
  width: 112rpx;
  height: 112rpx;
  border: 4rpx solid #fff;
  border-radius: 50%;
  overflow: hidden;
  background: var(--brand-border);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand-strong);
  font-size: 44rpx;
}
.avatar image {
  width: 100%;
  height: 100%;
}
.profile-body {
  flex: 1;
  min-width: 0;
}
.nickname {
  font-size: 36rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.mobile {
  font-size: 24rpx;
  color: #666;
  margin: 8rpx 0;
}
.badges {
  display: flex;
  gap: 12rpx;
  min-height: 34rpx;
}
.badge {
  font-size: 22rpx;
  line-height: 32rpx;
  padding: 3rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 600;
}
.certified {
  color: #fff;
  background: #218653;
}
.agent {
  color: #fff;
  background: var(--brand-strong);
}
.arrow {
  font-size: 52rpx;
  color: #666;
}
.assets {
  border-radius: 24rpx;
  overflow: hidden;
  background: white;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 30rpx #2020370a;
}
.asset-main {
  padding: 30rpx 28rpx;
  background: linear-gradient(to right top, var(--brand), var(--brand-strong));
  color: #fff;
}
.asset-title {
  font-size: 25rpx;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.eye {
  font-size: 32rpx;
  padding: 0 14rpx;
}
.asset-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 14rpx 0;
}
.main-amount {
  font-size: 54rpx;
  font-weight: 700;
  word-break: break-all;
  flex: 1;
  min-width: 0;
}
.vault {
  flex-shrink: 0;
  padding: 16rpx 24rpx;
  font-size: 25rpx;
  border-radius: 50rpx;
  background:var(--action-background);
  color: #fff;
  font-weight: 600;
}
.exchange-hint {
  font-size: 20rpx;
  color: #fff;
  border: 1rpx solid var(--brand-border);
  border-radius: 8rpx;
  padding: 4rpx 10rpx;
}
.metrics {
  display: flex;
  padding: 28rpx 8rpx;
}
.metric {
  width: 25%;
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}
.metric-label {
  font-size: 23rpx;
  color: #888;
}
.metric-value {
  font-size: 27rpx;
  font-weight: 600;
  word-break: break-all;
  text-align: center;
}
.metric-label-with-help {
  display: flex;
  align-items: center;
  gap: 8rpx;
  white-space: nowrap;
}
.metric-help {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  border: 1rpx solid currentColor;
  border-radius: 50%;
  font-size: 20rpx;
  line-height: 1;
}
.video-card {
  display: flex;
  gap: 18rpx;
  align-items: center;
  background: var(--brand-soft);
  padding: 26rpx 22rpx;
  border-radius: 22rpx;
  margin-bottom: 24rpx;
}
.video-icon {
  width: 70rpx;
  height: 70rpx;
  line-height: 70rpx;
  text-align: center;
  background: var(--brand);
  color: white;
  border-radius: 22rpx;
  font-size: 32rpx;
}
.video-body {
  flex: 1;
  min-width: 0;
}
.video-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand-strong);
}
.video-detail {
  font-size: 22rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin: 8rpx 0;
}
.video-action {
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: center;
  min-height: 70rpx;
  font-size: 23rpx;
  color: var(--brand-strong);
  flex-shrink: 0;
  white-space: nowrap;
}
.panel {
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  padding: 28rpx 18rpx 14rpx;
}
.panel-title {
  font-size: 31rpx;
  font-weight: 600;
  margin: 0 12rpx 22rpx;
}
.order-grid,
.service-grid {
  display: flex;
  flex-wrap: wrap;
}
.grid-item {
  width: 25%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  flex-direction: column;
  font-size: 24rpx;
  text-align: center;
}
.order-icon {
  color: var(--brand);
  font-size: 42rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin-bottom: 10rpx;
}
.order-grid {
  padding-bottom: 20rpx;
}
.service {
  padding: 14rpx 0 24rpx;
}
.service-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  font-size: 23rpx;
}
.service-icon {
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 32rpx;
}
.service picker {
  width: 100%;
}
.empty-state {
  text-align: center;
  padding: 140rpx 30rpx;
  color: #888;
  font-size: 27rpx;
}
