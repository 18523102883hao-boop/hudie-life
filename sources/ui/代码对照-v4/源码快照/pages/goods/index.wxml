<view style="width: 710rpx;margin: 20rpx;">
  <view class="lun" wx:if="{{goods && goods.imgs.length>0}}">
    <swiper class="luns" autoplay="play" circular interval="3000">
      <swiper-item wx:for="{{goods.imgs}}" wx:key="index" class="luns" data-item="{{item}}">
        <image mode="widthFix" src="{{item}}"></image>
      </swiper-item>
    </swiper>
  </view>
  <view style="width: 670rpx;background: #fff;margin-top: -20rpx;padding: 40rpx 20rpx 20rpx;border-radius: 0 0 20rpx 20rpx;">
    <view style="font-size: 36rpx;font-weight: 700;margin-bottom: 10rpx;">
      <block wx:if="{{goods.is_virtual != 1}}">
        <text style="color: var(--brand-strong);">{{goods.shop_name}}</text><text style="color: #9f9f9f;font-weight: 100;">丨</text>
      </block>
      {{goods.title}}
    </view>
    <view class="product-meta-row">
      <view class="product-meta-tags">
    <view wx:if="{{goods.max_commission}}" style="display: inline-block;border: 1px solid #fe0a0a;color: #fe0a0a;border-radius: 8rpx;padding: 4rpx 8rpx;font-size: 24rpx;">自购省 {{goods.max_commission}} | 分享赚 {{goods.max_commission}}</view>
    <view wx:if="{{goods.id && goods.need_book != null}}" class="product-detail-top-tag">{{goods.need_book == 0 ? '免预约' : (goods.book_text || '需预约')}}</view>
    <view wx:if="{{goods.id && goods.forward_days > 0}}" class="product-detail-top-tag">提前{{goods.forward_days}}天购买</view>
      </view>
      <view class="product-share-action" hover-class="theme-action-hover" wx:if="{{goods.max_commission}}" catchtap="savePoster" style="background:var(--action-background);color: #fff;text-align: center;line-height: 44rpx;font-size: 24rpx;border-radius: 22rpx;width: 145.454545454545rpx;height:44rpx;">立即分享 ↗</view>
    </view>
    <view style="margin-top: 20rpx;display: flex;justify-content: space-between;">
      <view style="color: #fe0a0a;">
        <text>￥</text><text style="font-weight: 700;font-size: 50rpx;">{{goods.subsidy_price}}</text>
        <text style="text-decoration: line-through;font-size: 28rpx;margin-left: 20rpx;color: #ccc;">门市价￥{{goods.market_price}}</text>
      </view>
      <view style="position: relative;width: 150rpx;font-size: 28rpx;">
        <text wx:if="{{goods.stock>2}}" style="color: #000;position: absolute;right: 0;bottom: 6rpx;">已售{{goods.virtual_sale_num+goods.sale_num}}份</text>
        <text wx:else style="color: #000;position: absolute;right: 0;bottom: 6rpx;">仅剩{{goods.stock}}份</text>
      </view>
    </view>
    <view wx:if="{{goods.id && goods.tag && goods.tag.length > 0}}" class="product-detail-service-row">
      <view wx:for="{{goods.tag}}" wx:key="*this" wx:for-item="gtag" wx:if="{{gtag}}" class="product-detail-service-item"><text class="product-detail-service-icon">✓</text>{{gtag}}</view>
    </view>
  </view>

  <view wx:if="{{goods_list.length > 0}}" style="width: 670rpx;margin-top: 20rpx;padding: 20rpx;background: #fff;border-radius: 20rpx;font-size: 30rpx;">
    <view style="width: 670rpx;display: flex;justify-content: space-between;line-height: 50rpx;border-bottom: 1rpx solid #f1f1f1;padding-bottom: 20rpx;margin-bottom: 20rpx;">
      <view>选择套餐</view>
    </view>
    <view catchtap="selGoodsSpec" data-item="{{item}}" style="width: 630rpx;display: flex;justify-content: center;align-items: center;border: 2rpx solid {{item.id==goods.id? 'var(--brand-strong)' : '#ccc'}};padding: 18rpx;border-radius: 10rpx;position: relative;margin-top: 20rpx;overflow: hidden;" wx:for="{{goods_list}}" wx:key="index">
      <view style="flex:1;min-width:0;font-size:26rpx;line-height:38rpx;word-break:break-all;">{{item.title}}</view>
      <view style="flex-shrink:0;min-width:150rpx;margin-left:16rpx;text-align:right;white-space:nowrap;font-size:36rpx;font-weight:700;color:#fe0a0a;">{{item.subsidy_price != null ? '￥' + item.subsidy_price : '价格待确认'}}</view>
      <view wx:if="{{item.id==goods.id}}" style="position: absolute;bottom: 0;right: 0;background: var(--brand-strong);border-radius: 10rpx 0 0;width: 30rpx;height: 30rpx;line-height: 30rpx;text-align: center;color: #fff;font-weight: 700;font-size: 20rpx;"><text class="icon iconfont icon-selected"></text></view>
    </view>
  </view>

  <view style="width: 670rpx;margin-top: 20rpx;padding: 20rpx;background: #fff;border-radius: 20rpx;font-size: 30rpx;">
    <view style="display: flex;">
      <view style="width: 100rpx;height: 100rpx;">  
        <image src="{{app.domain}}qun_head_img.png?t=11" style="width: 100%;height: 100%;"></image>
      </view>
      <view style="width: 340rpx;margin: 0 20rpx">
        <view style="line-height: 40rpx;font-size: 32rpx;margin-top: 10rpx;">蝴蝶优选帮砍群</view>
        <view style="line-height: 40rpx;font-size: 24rpx;color: #adadad;">上新提醒·积分福利·砍价互助</view>
      </view>
      <view style="width: 190rpx;">
        <view hover-class="theme-action-hover" style="width: 190rpx;text-align: center;line-height: 60rpx;margin-top: 20rpx;background:var(--action-background);color: #fff;border-radius: 30rpx;font-size: 24rpx;" catchtap="toCutQun">加入帮砍群</view>
      </view>
    </view>
  </view>
  <view wx:if="{{goods.cut_amount > 0}}" style="width: 670rpx;margin-top: 20rpx;padding: 20rpx;background: #fff;border-radius: 20rpx;font-size: 30rpx;">
    <view style="width: 630rpx;display: flex;justify-content: center;line-height: 60rpx;background: #fef8f1;padding: 10rpx 20rpx;border-radius: 20rpx;">
      <view style="width: 60rpx;height: 60rpx;"><image src="{{userinfo.img}}" style="width: 100%;height: 100%;border-radius: 50%;"></image></view>
      <view style="margin-left: 10rpx;font-weight: 700;color: #341202;display: flex;">
        本轮砍价时间剩余 
        <view style="margin: 0 6rpx 0 10rpx;padding: 0 6rpx;color: #fff;background: #e02f25;border-radius: 10rpx;">{{hour}}</view>:
        <view style="margin: 0 6rpx;padding: 0 6rpx;color: #fff;background: #e02f25;border-radius: 10rpx;">{{min}}</view>:
        <view style="margin: 0 6rpx;padding: 0 6rpx;color: #fff;background: #e02f25;border-radius: 10rpx;">{{sec1}}</view>
      </view>
    </view>
    <view style="font-weight: 700;margin-top: 20rpx;display: flex;justify-content: space-between;align-items: flex-end;">
      <view style="display: flex;align-items: flex-end;">
        <view style="line-height: 40rpx;height: 40rpx;background: #e02f26;color: #fff;padding: 0 10rpx;border-radius: 10rpx;font-size: 28rpx;">已砍</view>
        <view style="color: #e02f26;font-size: 70rpx;height: 70rpx;display: flex;align-items: flex-end;margin-left: 16rpx;">
          <view style="line-height: 54rpx;">{{goods.cut_amount}}</view>
        </view>
        <view style="line-height: 40rpx;height: 40rpx;color: #e02f26;font-size: 28rpx;margin-left: 6rpx;">
          <view style="line-height: 54rpx;">元</view>
        </view>
      </view>
      <view style="line-height: 50rpx;background: #fce7c5;padding: 0 20rpx;border-radius: 10rpx;" wx:if="{{goods.sec_price == goods.min_price}}">
        预计还需{{goods.person_num}}人帮砍
        <text class="icon iconfont icon-warning" style="color: #e02f26;font-size: 38rpx;margin-left: 10rpx;"></text>
      </view>
    </view>
    <view style="height: 28rpx;width: 670rpx;background: var(--brand);background-size: 100% 100%;border-radius: 15rpx;margin-top: 40rpx;position: relative;">
      <view style="position: absolute;height: 20rpx;width: calc({{(1-goods.cut_amount / goods.ca_price) * 670}}rpx);right: 2rpx;top: 4rpx;background: #b8b8b8;border-radius: 15rpx;"></view>
      <view style="background: var(--brand-strong);border-radius: 50%;box-shadow: 0 0 0 6rpx #fff;width: 50rpx;height: 50rpx;background-size: 100% 100%;position: absolute;top: -12rpx;right: calc({{(1 - goods.cut_amount / goods.ca_price) * 670}}rpx - 25rpx);"></view>
    </view>
    <view style="width: 630rpx;height: 65.69rpx;background: var(--brand-soft);border-radius: 12rpx;background-size: 100% 100%;margin-top: 40rpx;padding: 20rpx;display: flex;">
      <view style="width: 63.8rpx;height: 65.69rpx;color: var(--brand-strong);font-size: 28rpx;font-weight: 700;line-height: 32rpx;background-size: 100% 100%;">砍价记录</view>
      <view style="width: 2rpx;margin: 0 10rpx;background: #aaa;height: 65.69rpx;"></view>
      <view style="width: 103.108rpx;height: 65.69rpx;background-image: url('{{app.domain}}static/img/cut-img.png');background-size: 100% 100%;"></view>
      <view style="color: #341202;line-height: 65.69rpx;font-weight: 700;margin-left: 30rpx;width: 351.092rpx;">
        距最低价仅差<text style="color: #e12e21;">{{goods.ca_price}}元</text>
      </view>
      <view style="width: 45.69rpx;height: 45.69rpx;background-image: url('{{app.domain}}static/img/cut-right.png');background-size: 100% 100%;margin-top: 10rpx;" catchtap="showCutDetails"></view>
    </view>
    <view style="margin-top: 20rpx;text-align: center;">
      <view style="color: #341202;font-weight: 700;margin-bottom: 10rpx">已有<text style="color: #e12e21;font-weight: 700;font-size: 40rpx;">{{cut_details.length}}</text>人帮砍</view>
      <view style="display: flex;justify-content: center;flex-wrap: wrap;">
        <image src="{{item.img}}" wx:for="{{cut_details}}" wx:key="index" style="width: 60rpx;height: 60rpx;border-radius: 50%;margin-right: 10rpx;margin-bottom: 10rpx"></image>
      </view>
    </view>
    <view hover-class="theme-action-hover" style="width: 400rpx;height: 121.6374rpx;background:var(--action-background);color: #fff;line-height: 121.6374rpx;text-align: center;border-radius: 14rpx;font-size: 30rpx;font-weight: 700;background-size: 100% 100%;margin-top: 30rpx;margin-left: 135rpx;" catchtap="cutAmount">喊好友立即砍一刀</view>
    
    <view wx:if="{{show_cut_details}}" style="position: fixed;width: 100%;height: 100%;left: 0;top: 0;background: #00000066;z-index: 99;">
      <view style="position: absolute;width: 630rpx;left: 50rpx;background: #fff;top: calc(50vh - (160rpx + min(580rpx, {{cut_details.length}} * 120rpx)) / 2 - env(safe-area-inset-bottom) - 100rpx + 40rpx);max-height: 700rpx;padding: 20rpx;text-align: center;border-radius: 20rpx;">
        <view style="color: var(--brand-strong);font-weight: 700;font-size: 40rpx;line-height: 50rpx;">砍价记录</view>
        <view style="font-size: 24rpx;color: #666;margin-top: 20rpx;line-height: 30rpx;">小提示：邀请新用户帮砍，可以砍更多金额哦</view>
        <view style="max-height: 540rpx;background: var(--brand-soft);margin-top: 20rpx;overflow-y: scroll;border-radius: 20rpx;">
          <view wx:for="{{cut_details}}" wx:key="index" style="display: flex;padding: 20rpx;justify-content: space-between;line-height: 80rpx;{{cut_details.length == index+1 ? '' : 'border-bottom: 2rpx solid #eaeaea;'}}">
            <image src="{{item.img}}" style="width: 80rpx;height: 80rpx;border-radius: 50%;"></image>
            <view>{{item.nickname}}</view>
            <view style="color: #fe0a0a;">￥{{item.amount}}</view>
          </view>
        </view>
      </view>
      <view catchtap="hide_cut_details" style="position: absolute;width: 60rpx;height: 60rpx;line-height: 60rpx;text-align: center;font-size: 40rpx;border-radius: 50%;border: 2rpx solid #fff;color: #fff;top: calc(50vh + (160rpx + min(580rpx, {{cut_details.length}} * 120rpx)) / 2 - env(safe-area-inset-bottom) - 100rpx + 80rpx);left: 345rpx;"><text class="icon iconfont icon-x"></text></view>
    </view>
  </view>

  <view wx:if="{{goods.is_virtual != 1}}" style="width: 670rpx;margin-top: 20rpx;padding: 20rpx;background: #fff;border-radius: 20rpx;font-size: 30rpx;">
    <view style="width: 670rpx;display: flex;justify-content: space-between;line-height: 50rpx;border-bottom: 1rpx solid #f1f1f1;padding-bottom: 20rpx;margin-bottom: 20rpx;">
      <view>适用门店</view>
      <view catchtap="viewStore" style="font-size: 24rpx;" wx:if="{{goods.store.length > 1}}">{{goods.store.length}}家店适用<text class="icon iconfont icon-right"></text></view>
    </view>
    <view style="display: flex;justify-content: space-between;line-height: 40rpx;">
      <view style="width: 500rpx;line-height: 60rpx;font-weight: 700;">{{goods.store[0].name}}</view>
      <view hover-class="theme-action-hover" catchtap="daohang" data-item="{{goods.store[0]}}" style="font-size: 44rpx;line-height: 60rpx;background:var(--action-background);color:#fff;width: 60rpx;text-align: center;border-radius: 10rpx;">
        <text class="icon iconfont icon-logistics-tracking-fill"></text>
      </view>
      <view hover-class="theme-action-hover" data-phone="{{goods.store[0].mobile}}" catchtap="callPhone" style="font-size: 44rpx;line-height: 60rpx;background:var(--action-background);color:#fff;width: 60rpx;text-align: center;border-radius: 10rpx;">
        <text class="icon iconfont icon-phone-fill"></text>
      </view>
    </view>
    <view style="display: flex;justify-content: space-between;line-height: 30rpx;font-size: 24rpx;margin-top: 10rpx;">
      <view catchtap="daohang" style="width: 670rpx;color: #999;">{{goods.store[0].province}} {{goods.store[0].city}} {{goods.store[0].county}} {{goods.store[0].address}}</view>
    </view>
  </view>

  <view style="width: 670rpx;border-radius: 20rpx;padding: 20rpx;margin-top: 20rpx;background: #fff;">
    <view style="background-image: url('{{app.domain}}static/img/content-head.png?t=1');background-size: 100%;height: 279rpx;"></view>
    <view style="background-image: url('{{app.domain}}static/img/content-body.png');background-size: 100%;padding: 0 8.763%;padding-bottom: 20rpx;"><rich-text nodes="{{goods.extend.content}}"></rich-text></view>

  <view style="background-image: url('{{app.domain}}static/img/content-bottom.png');background-size: 100%;height: 58.52rpx;"></view>

    <view style="background-image: url('{{app.domain}}static/img/rule-head.png?t=2');background-size: 100%;height: 279rpx;margin-top: 20rpx;"></view>
    <view style="background-image: url('{{app.domain}}static/img/content-body.png');background-size: 100%;padding: 0 8.763%;padding-bottom: 20rpx;"><rich-text nodes="{{goods.extend.rule}}"></rich-text></view>
    <view style="background-image: url('{{app.domain}}static/img/content-bottom.png');background-size: 100%;height: 58.52rpx;"></view>
  </view>
  <view class="detail-info-card" wx:if="{{goods.id}}">
    <view class="detail-info-row" wx:if="{{goods.video_goods_id}}">
      <text class="detail-info-icon">▣</text>
      <text class="detail-info-label">视频号商品ID：</text>
      <text class="detail-info-value">{{goods.video_goods_id}}</text>
      <text class="detail-info-copy" catchtap="copyVideoGoodsId">复制</text>
    </view>
    <view class="detail-info-row detail-info-link" hover-class="theme-share-hover" catchtap="viewLicense">
      <text class="detail-info-icon">▤</text><text class="detail-info-link-text">商家资质</text><text class="icon iconfont icon-right detail-info-arrow"></text>
    </view>
    <view class="detail-info-row detail-info-link" hover-class="theme-share-hover" catchtap="openPartnerQr">
      <text class="detail-info-icon">♡</text><text class="detail-info-link-text">我是商家，想跟蝴蝶优选合作</text><text class="icon iconfont icon-right detail-info-arrow"></text>
    </view>
  </view>
</view>
<block wx:if="{{goods.id}}">
<view wx:if="{{goods.status != 1}}" style="width: 750rpx;height: 100rpx;position: fixed;bottom: 0;border-bottom: calc(env(safe-area-inset-bottom)) solid #f1f1f1;left: 0;background: #ccc;line-height: 100rpx;text-align: center;">
  {{goods.start_time <= now_time ? '已下架' : '未上架'}}
</view>
<view wx:elif="{{goods.start_time > now_time}}" style="width: 750rpx;height: 100rpx;position: fixed;bottom: 0;border-bottom: calc(env(safe-area-inset-bottom)) solid #f1f1f1;left: 0;background: #ffaa00;color: #fff;line-height: 100rpx;text-align: center;">
  {{goods.start_date}} 开售
</view>
<view wx:elif="{{goods.end_time < now_time}}" style="width: 750rpx;height: 100rpx;position: fixed;bottom: 0;border-bottom: calc(env(safe-area-inset-bottom)) solid #f1f1f1;left: 0;background: #ccc;line-height: 100rpx;text-align: center;">
  已下架
</view>
<view wx:elif="{{goods.total_stock <= 0}}" style="width: 750rpx;height: 100rpx;position: fixed;bottom: 0;border-bottom: calc(env(safe-area-inset-bottom)) solid #f1f1f1;left: 0;background: #ccc;line-height: 100rpx;text-align: center;">
  已抢光
</view>
<view wx:elif="{{goods.stock <= 0}}" style="width: 750rpx;height: 100rpx;position: fixed;bottom: 0;border-bottom: calc(env(safe-area-inset-bottom)) solid #f1f1f1;left: 0;background: #ccc;line-height: 100rpx;text-align: center;">
  今日已抢光，请明日再来~
</view>
<view wx:else style="width: 750rpx;height: 100rpx;position: fixed;bottom: 0;border-bottom: calc(env(safe-area-inset-bottom)) solid #f1f1f1;left: 0;display: flex;text-align: center;">
  <view hover-class="{{goods.sale_price <= goods.min_price ? 'none' : 'theme-action-hover'}}" style="width: 50%;height: 100rpx;background: {{goods.sale_price <= goods.min_price ? '#ccc' : 'var(--action-background)'}};color: #fff;">
    <block wx:if="{{goods.sale_price <= goods.min_price}}">
      <text style="line-height: 100rpx;">已砍至最低价</text>
    </block>
    <block wx:else>
      <view hover-class="theme-action-hover" style="margin-top: 4rpx" catchtap="cutAmount">
        <text style="font-size: 40rpx;">{{goods.cut_amount > 0 ? '邀请帮砍' : '砍价'}}</text>
      </view>
      <view style="font-size: 24rpx;line-height: 32rpx;">（最低砍至{{goods.min_price}}元）</view>
    </block>
  </view>
  <view hover-class="theme-action-hover" catchtap="toBuy" style="width: 50%;height: 100rpx;background:var(--action-background);line-height: 40rpx;color: #fff;font-weight: 700">
    <view style="margin-top: 10rpx">
      <text style="font-size: 40rpx;">￥{{goods.sale_price}}</text>
      <text style="font-size: 24rpx;color: #777;text-decoration: line-through;">门市价￥{{goods.market_price}}</text>
    </view>
    <view style="font-size: 30rpx;line-height: 32rpx;">立即购买</view>
  </view>
</view>
</block>
<view style="width: 1rpx;height: calc(env(safe-area-inset-bottom) + 20rpx + 100rpx);"></view>

<view wx:if="{{show_cut_msg}}" style="position: fixed;left: 0;top: 0;background: #00000066;z-index: 9;width: 100%;height: 100%;">
  <view hover-class="theme-action-hover" style="position: absolute;right: 125rpx;top: calc((100vh - 500rpx - env(safe-area-inset-bottom) - 250rpx) / 2);z-index: 1;font-size: 24rpx;width: 120rpx;text-align: center;line-height: 40rpx;border-radius: 20rpx;background:var(--action-background);color:#fff;" catchtap="closeCutMsg">关闭 {{sec>0?sec:''}}</view>
  <view style="position: absolute;height: 587rpx;width: 686rpx;left: 32rpx;top: calc((100vh - 587rpx - env(safe-area-inset-bottom) - 250rpx) / 2);border-radius: 20rpx;">
    <image src="{{app.domain}}static/img/cut_alert.png?t=1" style="width: 100%;height: 100%;"></image>
    <view style="line-height: 80rpx;font-size: 60rpx;color: #fe0a0a;font-weight: 700;text-align: center;width: 286rpx;position: absolute;top: 282rpx;left: 200rpx;">{{cut_price}}元</view>
    <view style="width: 410rpx;font-size: 24rpx;text-align: center;color: #fff;position: absolute;top: 410rpx;left: 138rpx">砍价成功，当前商品最终价格仅当日有效，先抢先得</view>
  </view>
</view>
<view wx:if="{{show_share}}" style="position: fixed;left: 0;top: 0;background: #00000066;z-index: 9;width: 100%;height: 100%;">
  <view style="position: absolute;width: 620rpx;height: 850rpx;left: 65rpx;top: calc((100vh - 850rpx - env(safe-area-inset-bottom) - 250rpx) / 2)" wx:if="{{goods.poster}}">
    <image show-menu-by-longpress src="{{goods.poster}}" style="width: 620rpx;height: 850rpx;" mode="aspectFit"></image>
    <text wx:if="{{show_share==2 && !goods.copywriting}}" catchtap="closeShare" class="icon iconfont icon-close" style="display: block;width: 60rpx;height: 60rpx;font-size: 40rpx;color: #fff;border-radius: 50%;border: 1px solid #fff;text-align: center;line-height: 60rpx;margin: 40rpx 280rpx 0;"></text>
  </view>
  <view wx:if="{{show_share == 2 && goods.copywriting}}" style="position: absolute;bottom: 0;padding: 20rpx 20rpx calc(env(safe-area-inset-bottom) + 10rpx);background: var(--brand-soft);">
    <view style="display: flex;justify-content: space-around;">
      <view hover-class="theme-action-hover" catchtap="savePosterImg" style="background:var(--action-background);color: #fff;margin-bottom: 20rpx;padding: 10rpx 20rpx;font-size: 24rpx;border-radius: 20rpx;"><text class="icon iconfont icon-save"></text>一键保存海报</view>
      <view hover-class="theme-action-hover" catchtap="copyText" style="background:var(--action-background);color: #fff;margin-bottom: 20rpx;padding: 10rpx 20rpx;font-size: 24rpx;border-radius: 20rpx;"><text class="icon iconfont icon-copy"></text>一键复制文案</view>
      <view hover-class="theme-action-hover" catchtap="closeShare" style="margin-bottom: 20rpx;padding: 10rpx 20rpx;font-size: 24rpx;border-radius: 20rpx;background:var(--action-background);color:#fff;">关闭</view>
    </view>
    <view style="width: 670rpx;background: #fff;border-radius: 20rpx;padding: 20rpx;height: 160rpx;overflow-y: scroll;">
      <text>{{goods.copywriting}}</text>
    </view>
  </view>
  <view wx:if="{{show_share==1}}" style="position: absolute;bottom: 0;left: 0;">
    <view style="background: #fff;padding: 30rpx 40rpx 20rpx;border-radius: 20rpx 20rpx 0 0;">
      <view style="display: flex;text-align: center;border-bottom: 1px solid #f1f1f1;padding-bottom: 20rpx;">
        <button plain="true" open-type="share" hover-class="theme-share-hover" style="width: 33.33%;box-sizing: border-box;padding: 0;border: 0;font-weight: 100;font-size: 28rpx;border-right: 1px solid #f1f1f1;">
          <view class="theme-action-icon" style="background:var(--action-background);width: 109rpx;height: 108rpx;color: #fff;font-size: 70rpx;line-height: 108rpx;border-radius: 24rpx;display: inline-block;">↗</view>
          <view>发送给好友</view>
        </button>
        <view hover-class="theme-share-hover" catchtap="savePoster" style="width: 33.33%;border-right: 1px solid #f1f1f1;box-sizing: border-box;font-weight: 100;font-size: 28rpx;">
          <view class="theme-action-icon" style="border-radius:24rpx;background:var(--action-background);width: 109rpx;height: 108rpx;color:#fff;font-size:64rpx;line-height:108rpx;display:inline-block;"><text class="icon iconfont icon-save"></text></view>
          <view>保存海报</view>
        </view>
        <view hover-class="theme-share-hover" catchtap="toBuy" style="width: 33.33%;font-weight: 100;font-size: 28rpx;">
          <view class="theme-action-icon" style="border-radius:24rpx;background:var(--action-background);width: 109rpx;height: 108rpx;color:#fff;font-size:64rpx;line-height:108rpx;display:inline-block;">¥</view>
          <view>立即购买</view>
        </view>
      </view>
      <view style="text-align: center;margin-top: 20rpx;" catchtap="closeShare">关闭</view>
    </view>
    <view style="width: 750rpx;height: calc(env(safe-area-inset-bottom));background: #f1f1f1;"></view>
  </view>
</view>
<view wx:if="{{detail_show_partner_qr}}" class="detail-partner-mask" catchtap="closePartnerQr">
  <view class="detail-partner-panel" catchtap="stopPartnerQrTap">
    <image class="detail-partner-image" src="{{app.domain}}static/img/kf_qrcode.png" mode="widthFix" show-menu-by-longpress binderror="partnerQrError"></image>
    <view class="detail-partner-close" catchtap="closePartnerQr">×</view>
  </view>
</view>
