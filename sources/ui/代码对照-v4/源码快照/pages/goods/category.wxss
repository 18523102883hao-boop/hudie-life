page{background:#f7f7f7}.primary-tabs{background:#fff;width:100%;white-space:nowrap}.primary-row{display:inline-flex;min-width:100%;height:100rpx;align-items:center}.primary-tab{position:relative;padding:26rpx 32rpx;color:#666;font-size:30rpx}.primary-tab.active{color:var(--brand-strong);font-weight:700}.primary-tab.active:after{content:'';position:absolute;height:6rpx;bottom:7rpx;left:32rpx;right:32rpx;background:var(--brand);border-radius:4rpx}.catalog-message{padding:50rpx 32rpx;text-align:center;color:#888;font-size:28rpx}.catalog-message button{margin-top:24rpx;font-size:28rpx;color:#fff;background:var(--action-background)}
