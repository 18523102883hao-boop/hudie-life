page{background: #fafafa}
.nav-main::before{content:'';position: absolute;left: 0;top: 0;right: 0;bottom: 0;width: 100%;height: 100%;z-index: -1;}
.view{width:710rpx;align-items:center;justify-content:space-between}
.lun{height:274.93rpx;width: 750rpx;}
.luns{border-radius: 0;overflow: hidden;}

.cate_list::-webkit-scrollbar {display: none;}
.cate_list{width: 750rpx;overflow-x: scroll;}
.cate_list .cate_box{display: flex;width: 1520rpx;padding: 10rpx;}
.cate_list .cate_box .cate_one{font-size: 26rpx;line-height: 44rpx;width: 150rpx;text-align: center;background: #f1f1f1;color: #333;margin: 10rpx;border-radius: 10rpx;}
.cate_list .cate_box .cate_one.on{background: var(--brand-soft);color: var(--brand-strong);font-weight: 700;}