<view style="width: 710rpx;margin: 20rpx;">
  <view style="display: inline-block;font-size: 40rpx;font-weight: 700;">
    <view wx:if="{{info.status == 1}}" style="background: #fbfaf6;border-color: #f9f3e3;color: #fbe5b1;">待支付</view>
    <view wx:elif="{{info.status == 2}}" style="background: #f6ffed;border-color: #b7eb8f;color: #52c41a;">待使用</view>
    <view wx:elif="{{info.status == 20}}" style="background: #effbf2;border-color: #c3f7d2;color: #5fb878;">部分使用</view>
    <view wx:elif="{{info.status == 3}}" style="background: #fdf5f0;border-color: #ffd3be;color: #f66c2c;">已完成</view>
    <view wx:elif="{{info.status == 4}}" style="background: #fffde4;border-color: #fdf7a5;color: #ffee00;">已过期</view>
    <view wx:elif="{{info.status == 90}}" style="background: #f7eeed;border-color: #f5bab5;color: #e63e30;">退款处理中</view>
    <view wx:elif="{{info.status == 9}}" style="background: #fff1f0;border-color: #ffa39e;color: #f5222d;">已退款</view>
    <view wx:elif="{{info.status == -1}}" style="background: #ffffff;border-color: #f4f4f4;color: #333333;">已取消</view>
    <view wx:else style="background: #ffffff;border-color: #f4f4f4;color: #999;">未知</view>
  </view>
  <view wx:if="{{info.status==2}}" style="font-size: 24rpx;color: #999;margin-top: 10rpx;">请在{{info.expire_date}}(含)前到店消费</view>
  <view wx:if="{{info.expire_day<=3 && info.expire_day>0}}" style="font-size: 24rpx;color: #999;margin: 20rpx 0;font-size: 30rpx;padding: 6rpx 20rpx;background: #fdf9f0;border: 1px solid #fd802e33;border-radius: 20rpx;line-height: 50rpx;">
    <text class="icon iconfont icon-info" style="color: #fd802e;"> 该商品还有{{info.expire_day}}天过期，过期后不可使用</text>
  </view>
  <block wx:if="{{!info.hotel_booking.is_hotel}}">
  <block wx:if="{{!info.goods.verify_tips}}">
  <view wx:if="{{info.goods.is_virtual == 0 && (info.status==2 || info.status==3 || info.status==4)}}" style="width: 670rpx;margin-top: 20rpx;background: #fff;border-radius: 20rpx;padding: 20rpx;">
    <view style="font-weight: 700;">{{info.goods.verify_tips||'凭「券码或券号」到店使用'}}</view>
    <view wx:if="{{info.status==2 && (info.qrcode || info.code_url)}}" style="margin-top: 20rpx;display: flex;">
      <view style="width: 120rpx;height: 50rpx;line-height: 50rpx;background: #f4f5f7;text-align: center;border-radius: 10rpx;color: #333;">券 码</view>
      <view style="margin-left: 80rpx;width: 470rpx;">
        <image wx:if="{{info.qrcode}}" src="{{info.qrcode}}" style="margin-left: 80rpx;width: 300rpx;height: 300rpx;"></image>
        <view wx:elif="{{info.code_url}}" style="width: 160rpx;text-align: center;line-height: 50rpx;border-radius: 10rpx;border: 1rpx solid var(--action);color:var(--action);background:#fff;" catchtap="copyQrcode" hover-class="soft-action-hover">复制券码</view>
      </view>
    </view>
    <view wx:if="{{(info.status==2 || info.status==3 || info.status==4) && info.code.length>0}}" style="display: flex;">
      <view style="width: 120rpx;height: 50rpx;line-height: 50rpx;background: #f4f5f7;text-align: center;border-radius: 10rpx;color: #333;">券 号</view>
      <view style="line-height: 50rpx;width: 550rpx;">
        <block wx:for="{{info.code}}" wx:key="index">
          <view style="margin-left: 80rpx;width: 470rpx;box-sizing:border-box;padding: 0 16rpx;margin-top: 20rpx;border-radius: 12rpx;background:#fff6f2;border: 1rpx solid #f8dccd;color:#333;{{item.verify_time?'display:flex;justify-content: space-between;background:#f7f8fa;border-color:#eceef1;':''}}" catchtap="copyCode" data-code="{{item.code}}" hover-class="soft-action-hover">
            <view style="display: flex;justify-content: space-between;align-items:center;" wx:if="{{!item.verify_time}}">
              <view>
                <text style="font-weight:700;font-size:30rpx;letter-spacing:2rpx;color:var(--action);">{{item.code}} </text>
                <text class="icon iconfont icon-copy" style="color:var(--action);font-size:24rpx;margin-left:6rpx;"></text>
              </view>
              <view wx:if="{{item.code_url}}" style="font-size: 22rpx;line-height: 38rpx;padding: 0 14rpx;border-radius: 19rpx;border: 1rpx solid var(--action);color:var(--action);background:#fff;" catchtap="showCodeUrl" data-code_url="{{item.code_url}}" hover-class="soft-action-hover">查看券码</view>
            </view>
            <block wx:else>
              <text style="font-weight:700;font-size:30rpx;letter-spacing:2rpx;color:#999;text-decoration: line-through;">{{item.code}} </text>
              <text style="color: #999;font-size: 24rpx;">{{item.verify_time}}</text>
            </block>
          </view>
        </block>
      </view>
    </view>
  </view>
  </block>
  <view wx:else style="width: 670rpx;margin-top: 20rpx;background: #fff;border-radius: 20rpx;padding: 20rpx;"><view style="font-weight: 700;">{{info.goods.verify_tips}}</view></view>
  </block>
  <view wx:if="{{info.hotel_booking.is_hotel}}" style="margin-top:20rpx;padding:24rpx;background:#fff;border-radius:20rpx;">
    <view style="font-weight:700;">酒店预约</view>
    <view wx:if="{{info.hotel_booking.latest}}" style="line-height:50rpx;">
      <view>{{info.hotel_booking.latest.status_text || '查看预约进度'}}</view>
      <view>{{info.hotel_booking.latest.checkin}} 至 {{info.hotel_booking.latest.checkout}}</view>
      <view>{{info.hotel_booking.latest.room_type_name}} · {{info.hotel_booking.latest.room_count}}间</view>
    </view>
    <view wx:else style="color:#888;margin:20rpx 0;">入住前请先预约，提交后等待商家确认</view>
    <button wx:if="{{info.hotel_booking.source==='taimu' || info.hotel_booking.can_submit || info.hotel_booking.latest}}" bindtap="openHotelBooking" style="margin-top:20rpx;background:var(--action-background);color:#fff;">{{info.hotel_booking.latest ? '查看预约' : '预约入住'}}</button>
  </view>

  <view wx:if="{{show_code_url}}" style="position: fixed;width: 100%;height: 100%;background: #00000060;top: 0;left: 0;">
    <view style="position: absolute;width: 650rpx;left: 50rpx;top: 100rpx;height: auto;">
      <image src="{{code_url}}" mode="aspectFit" style="width: 100%;height: 650rpx;"></image>
    </view>
    <view catchtap="hideCodeUrl" style="position: absolute;width: 80rpx;height: 80rpx;top: 800rpx;left: 335rpx;border-radius: 50%;border: 2rpx solid #fff;text-align: center;background:var(--action-background);color:#fff;" hover-class="theme-action-hover"><text class="icon iconfont icon-close" style="line-height: 80rpx;color: #fff;font-size: 40rpx;"></text></view>
  </view>
  <view catchtap="viewGoods" style="width: 670rpx;margin-top: 20rpx;padding: 20rpx;background: #fff;display: flex;border-radius: 20rpx;justify-content: space-between;">
    <view style="width: 250rpx;">
      <image src="{{info.goods.imgs[0]}}" style="width: 250rpx;height: 200rpx;border-radius: 20rpx;"></image>
    </view>
    <view style="width: 400rpx;">
      <view style="line-height: 40rpx;height: 120rpx;font-weight: 700;display: -webkit-box;-webkit-box-orient: vertical;-webkit-line-clamp: 3;overflow: hidden;text-overflow: ellipsis;">{{info.goods.title}}</view>
      <view style="height: 60rpx;margin-top: 20rpx">
        <text style="font-size: 30rpx;color: #fe0a0a;">优惠价</text>
        <text style="font-size: 36rpx;color: #fe0a0a;">￥{{info.goods.price}} </text>
        <text style="font-size: 24rpx;color: #777;text-decoration: line-through;"> 门市价￥{{info.goods.market_price}}</text>
      </view>
    </view>
  </view>
  
  <view wx:if="{{info.ssq.length > 0 && info.addr.length > 0}}" style="width: 670rpx;margin-top: 20rpx;padding: 20rpx;background: #fff;border-radius: 20rpx;font-size: 30rpx;">
    <view style="width: 670rpx;line-height: 50rpx;margin-bottom: 10rpx;">
      <view style="font-weight: 700;">收货信息</view>
    </view>
    <view style="display: flex;justify-content: space-between;line-height: 50rpx;">
      <view style="color: #666;width: 160rpx;">收货人</view>
      <view style="width: 510rpx;">{{info.name}}</view>
    </view>
    <view style="display: flex;justify-content: space-between;line-height: 50rpx;">
      <view style="color: #666;width: 160rpx;">收货电话</view>
      <view style="width: 510rpx;">{{info.mobile}}</view>
    </view>
    <view style="display: flex;justify-content: space-between;line-height: 50rpx;">
      <view style="color: #666;width: 160rpx;">收货地址</view>
      <view style="width: 510rpx;">{{info.ssq}} {{info.addr}}</view>
    </view>
    <view style="display: flex;justify-content: space-between;line-height: 50rpx;" wx:if="{{info.express_no}}">
      <view style="color: #666;width: 160rpx;">快递单号</view>
      <view style="width: 510rpx;">{{info.express_no}}</view>
    </view>
  </view>

  <view wx:if="{{info.goods.is_virtual != 1}}" style="width: 670rpx;margin-top: 20rpx;padding: 20rpx;background: #fff;border-radius: 20rpx;font-size: 30rpx;">
    <view style="width: 670rpx;display: flex;justify-content: space-between;line-height: 50rpx;border-bottom: 1rpx solid #f1f1f1;padding-bottom: 20rpx;margin-bottom: 20rpx;">
      <view>{{info.goods.shop_name}}</view>
      <view catchtap="viewStore" style="font-size: 24rpx;padding: 0 14rpx;line-height: 44rpx;border-radius: 22rpx;border: 1rpx solid var(--action);color:var(--action);background:#fff;" wx:if="{{info.store.length > 1}}" hover-class="soft-action-hover">{{info.store.length}}家店适用<text class="icon iconfont icon-right"></text></view>
    </view>
    <view style="display: flex;justify-content: space-between;line-height: 40rpx;align-items: center;">
      <view style="width: 500rpx;line-height: 60rpx;font-weight: 700;">{{info.store[0].name}}</view>
      <view catchtap="daohang" data-item="{{info.store[0]}}" style="font-size: 40rpx;line-height: 60rpx;height:60rpx;width: 60rpx;text-align: center;border-radius: 12rpx;background:#fff2ec;color:var(--action);" hover-class="soft-action-hover">
        <text class="icon iconfont icon-logistics-tracking-fill"></text>
      </view>
      <view data-phone="{{info.store[0].mobile}}" catchtap="callPhone" style="font-size: 40rpx;line-height: 60rpx;height:60rpx;width: 60rpx;text-align: center;border-radius: 12rpx;background:#fff2ec;color:var(--action);" hover-class="soft-action-hover">
        <text class="icon iconfont icon-phone-fill"></text>
      </view>
    </view>
    <view style="display: flex;align-items: center;line-height: 36rpx;font-size: 24rpx;margin-top: 10rpx;">
      <text class="icon iconfont icon-location" style="color:var(--action);font-size:26rpx;margin-right:8rpx;"></text>
      <view catchtap="daohang" style="flex: 1;color:#888;" hover-class="soft-action-hover">{{info.store[0].province}} {{info.store[0].city}} {{info.store[0].county}} {{info.store[0].address}}</view>
    </view>
  </view>
  <view style="width: 670rpx;margin-top: 20rpx;padding: 20rpx;background: #fff;border-radius: 20rpx;font-size: 30rpx;">
    <view style="width: 670rpx;line-height: 50rpx;margin-bottom: 10rpx;">
      <view style="font-weight: 700;">订单信息</view>
    </view>
    <view style="display: flex;justify-content: space-between;line-height: 50rpx;">
      <view style="color: #666;width: 160rpx;">订 单 号</view>
      <view style="width: 510rpx;">{{info.no}}</view>
    </view>
    <view style="display: flex;justify-content: space-between;line-height: 50rpx;">
      <view style="color: #666;width: 160rpx;">姓ㅤㅤ名</view>
      <view style="width: 510rpx;font-weight: 700;">{{info.name}}</view>
    </view>
    <view style="display: flex;justify-content: space-between;line-height: 50rpx;">
      <view style="color: #666;width: 160rpx;">手机号码</view>
      <view style="width: 510rpx;font-weight: 700;">{{info.mobile}}</view>
    </view>
    <view style="display: flex;justify-content: space-between;line-height: 50rpx;color: #fe0a0a;" wx:if="{{info.refund_date}}">
      <view style="color: #666;width: 160rpx;">退款时间</view>
      <view style="width: 510rpx;">{{info.refund_date}}</view>
    </view>
    <view style="display: flex;justify-content: space-between;line-height: 50rpx;" wx:if="{{info.pay_date}}">
      <view style="color: #666;width: 160rpx;">支付时间</view>
      <view style="width: 510rpx;">{{info.pay_date}}</view>
    </view>
    <view style="display: flex;justify-content: space-between;line-height: 50rpx;">
      <view style="color: #666;width: 160rpx;">下单时间</view>
      <view style="width: 510rpx;">{{info.add_date}}</view>
    </view>
    <view style="display: flex;justify-content: space-between;line-height: 50rpx;" wx:if="{{info.remark}}">
      <view style="color: #666;width: 160rpx;">备ㅤㅤ注</view>
      <view style="width: 510rpx;">{{info.remark}}</view>
    </view>
    <view style="width: 100%;height: 1px;background: #f1f1f1;margin: 10rpx 0"></view>
    <view style="display: flex;justify-content: space-between;line-height: 50rpx;">
      <view style="color: #666;width: 160rpx;">购买份数</view>
      <view style="width: 510rpx;">{{info.num}}份</view>
    </view>
    <view style="display: flex;justify-content: space-between;line-height: 50rpx;">
      <view style="color: #666;width: 160rpx;">订单金额</view>
      <view style="width: 510rpx;">￥{{info.amount}}</view>
    </view>
    <view style="display: flex;justify-content: space-between;line-height: 50rpx;">
      <view style="color: #666;width: 160rpx;">实付金额</view>
      <view style="width: 510rpx;">￥{{info.amount}}</view>
    </view>
  </view>
</view>

<view style="width: 1rpx;height: calc(max(env(safe-area-inset-bottom), 20rpx));"></view>

<import src="/utils/common/alert_imgs"></import>
<template is="alert_imgs" data="{{app,showAlert,alertList}}"></template>
