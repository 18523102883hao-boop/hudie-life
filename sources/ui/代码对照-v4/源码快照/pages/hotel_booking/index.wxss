.page{padding:20rpx;background:#f8f8f8;min-height:100vh}.card{background:#fff;border-radius:20rpx;padding:24rpx;margin-bottom:20rpx;line-height:52rpx}.title{font-size:32rpx;font-weight:700;margin-bottom:20rpx}.field{padding:18rpx 0;border-bottom:1rpx solid #eee;display:flex;justify-content:space-between}.field input{width:400rpx;text-align:right}.muted{font-size:26rpx;color:#888;line-height:42rpx;margin-top:20rpx}.primary{background:var(--action-background,#26a23b);color:#fff;margin-top:24rpx}.day{font-size:26rpx}textarea{width:100%;height:150rpx;background:#f8f8f8;margin:20rpx 0;padding:12rpx;box-sizing:border-box}
