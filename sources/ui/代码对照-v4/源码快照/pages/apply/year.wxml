<view style="width: calc(max(1600rpx, 100vw));">
  <view style="display: flex;">
    <view style="display: flex;">
      <view style="border-top: 40rpx solid #f7c643;border-bottom: 40rpx solid #f7c643;border-left: 40rpx solid transparent;border-right: 40rpx solid #f7c643;width: 0;height: 0;"></view>
      <view style="background: #f7c643;height: 80rpx;font-size: 20rpx;line-height: 30rpx;color: #fff;text-indent: -20rpx;">
        <view style="text-align: center;margin-top: 10rpx;">提交申请</view>
        <view>{{data.info.add_time}}</view>
      </view>
      <view style="border-top: 40rpx solid transparent;border-bottom: 40rpx solid transparent;border-left: 40rpx solid #f7c643;border-right: 40rpx solid transparent;width: 0;height: 0;"></view>
    </view>
    <view style="display: flex;" wx:for="{{data.examine}}" wx:key="index" catchtap="showReason" data-item="{{item}}">
      <view style="border-top: 40rpx solid {{item.color}};border-bottom: 40rpx solid {{item.color}};border-left: 40rpx solid transparent;border-right: 40rpx solid {{item.color}};width: 0;height: 0;"></view>
      <view style="background: {{item.color}};height: 80rpx;font-size: 20rpx;line-height: 30rpx;color: #fff;text-indent: -20rpx;">
        <view style="text-align: center;margin-top: 10rpx;">{{item.state}}</view>
        <view>{{item.add_time}}</view>
      </view>
      <view style="border-top: 40rpx solid transparent;border-bottom: 40rpx solid transparent;border-left: 40rpx solid {{item.color}};border-right: 40rpx solid transparent;width: 0;height: 0;"></view>
    </view>
  </view>
  <view style="text-align: center;font-size: 44rpx;font-weight: 700;">申请家庭基本情况</view>
  <view style="text-align: center;border-right: 2rpx solid #ccc;border-bottom: 2rpx solid #ccc;">
    <view style="display: flex;">
      <view class="th" style="width: 10%;">申请人</view>
      <view class="td" style="width: 15%;">{{data.name}}</view>
      <view class="th" style="width: 15%;">保障编号</view>
      <view class="td" style="width: 15%;">{{data.house_no}}</view>
      <view class="th" style="width: 15%;">身份证号码</view>
      <view class="td" style="width: 30%;">{{data.id_card}}</view>
    </view>
    <view style="display: flex;">
      <view class="th" style="width: 20%;">户口所在地社区</view>
      <view class="td" style="width: 45%;">{{data.community}}</view>
      <view class="th" style="width: 15%;">家庭类别</view>
      <view class="td" style="width: 20%;">{{data.home_type}}</view>
    </view>
    <view style="display: flex;">
      <view class="th" style="width: 15%;">家庭现住址</view>
      <view class="td" style="width: 50%;">{{data.residential_address}}</view>
      <view class="th" style="width: 15%;">联系电话</view>
      <view class="td" style="width: 20%;">{{data.mobile}}</view>
    </view>
    <view style="display: flex;">
      <view class="th" style="width: 3%;">基本情况</view>
      <view style="width: 97%;display: flex;flex-wrap: wrap;">
        <view style="width: 100%;display: flex;">
          <view class="td" style="width: 10%;justify-content: flex-start;">
            <checkbox-group>
            <label class="radio" style="display: inline-block;margin-left: 20rpx;" >
              <checkbox color="#0879b5" disabled="{{true}}" value="house_status.0.is_rent.1" checked="{{data.house_status[0].is_rent == 1}}" />租住
            </label>
            </checkbox-group>
          </view>
          <view style="width: 90%;">
            <view style="display: flex;">
              <view class="td" style="width: 30%;">ㅤ</view>
              <view class="td" style="width: 35%;">现住房面积</view>
              <view class="td" style="width: 35%;">同住人口数</view>
            </view>
            <view style="display: flex;">
              <view class="td" style="width: 30%;">
                <radio-group>
                <label class="radio" style="width: 130rpx;display: inline-block;" >
                  <radio color="#0879b5" disabled="{{true}}"  value="house_status.0.type.1" checked="{{data.house_status[0].type == 1}}" />合租
                </label>
                <label class="radio" style="width: 130rpx;display: inline-block;" >
                  <radio color="#0879b5" disabled="{{true}}"  value="house_status.0.type.2" checked="{{data.house_status[0].type == 2}}" />独租
                </label>
                </radio-group>
              </view>
              <view class="td" style="width: 35%;">{{data.house_status[0].area}}</view>
              <view class="td" style="width: 35%;">{{data.house_status[0].person_num}}</view>
            </view>
          </view>
        </view>
        <view style="width: 100%;display: flex;">
          <view class="td" style="width: 37%;justify-content: flex-start;">
            <checkbox-group>
            <label class="radio" style="display: inline-block;margin-left: 20rpx;">
              <checkbox color="#0879b5" disabled="{{true}}" value="house_status.1.is_owner.1" checked="{{data.house_status[1].is_owner == 1}}" />自有住房
            </label>
            </checkbox-group>
          </view>
          <view class="td" style="width: 31.5%;">{{data.house_status[1].area}}</view>
          <view class="td" style="width: 31.5%;">{{data.house_status[1].person_num}}</view>
        </view>
        <view style="width: 100%;display: flex;">
          <view class="td" style="width: 37%;justify-content: flex-start;">
            <checkbox-group>
            <label class="radio" style="display: inline-block;margin-left: 20rpx;">
              <checkbox color="#0879b5" disabled="{{true}}" value="house_status.2.is_company.1" checked="{{data.house_status[2].is_company == 1}}" />租住单位公房
            </label>
            </checkbox-group>
          </view>
          <view class="td" style="width: 31.5%;">{{data.house_status[2].area}}</view>
          <view class="td" style="width: 31.5%;">{{data.house_status[2].person_num}}</view>
        </view>
        <view style="width: 100%;display: flex;">
          <view class="td" style="width: 37%;justify-content: flex-start;">
            <checkbox-group>
            <label class="radio" style="display: inline-block;margin-left: 20rpx;">
              <checkbox color="#0879b5" disabled="{{true}}" value="house_status.3.is_rental.1" checked="{{data.house_status[3].is_rental == 1}}" />租赁廉租住房
            </label>
            </checkbox-group>
          </view>
          <view class="td" style="width: 31.5%;">{{data.house_status[3].area}}</view>
          <view class="td" style="width: 31.5%;">{{data.house_status[3].person_num}}</view>
        </view>
        <view style="width: 100%;display: flex;">
          <view class="td" style="width: 100%;justify-content: flex-start;">
            <checkbox-group>
            <label class="radio" style="display: inline-block;margin-left: 20rpx;">
              <checkbox color="#0879b5" disabled="{{true}}" value="is_reside.1" checked="{{data.is_reside == 1}}" />该家庭不在已配租的廉租住房内居住
            </label>
            </checkbox-group>
          </view>
        </view>
        <view style="width: 100%;display: flex;">
          <view class="td" style="width: 100%;justify-content: flex-start;">
            <checkbox-group>
            <label class="radio" style="display: inline-block;margin-left: 20rpx;">
              <checkbox color="#0879b5" disabled="{{true}}" value="is_change.1" checked="{{data.is_change == 1}}" />该家庭改变实物配租房源的用途
            </label>
            </checkbox-group>
          </view>
        </view>
        <view style="width: 100%;display: flex;">
          <view class="td" style="width: 100%;justify-content: flex-start;">
            <checkbox-group>
            <label class="radio" style="display: inline-block;margin-left: 20rpx;">
              <checkbox color="#0879b5" disabled="{{true}}" value="is_basic.1" checked="{{data.is_basic == 1}}" />该家庭停止享受低保待遇
            </label>
            </checkbox-group>
          </view>
        </view>
        <view style="width: 100%;display: flex;">
          <view class="td" style="width: 100%;justify-content: flex-start;">
            <checkbox-group>
            <label class="radio" style="display: inline-block;margin-left: 20rpx;">
              <checkbox color="#0879b5" disabled="{{true}}" value="is_hardship.1" checked="{{data.is_hardship == 1}}" />该家庭停止享受特困救助待遇
            </label>
            </checkbox-group>
          </view>
        </view>
        <view style="width: 100%;display: flex;">
          <view class="td" style="width: 100%;justify-content: flex-start;padding-left: 20rpx;">
            家庭人均收入<view style="display: inline-block;padding: 0 20rpx;border-bottom: 2rpx solid #ccc;">{{data.per_annual_income?data.per_annual_income:'ㅤ'}}</view>元/年，
            上年人均收入高于认定标准<view style="display: inline-block;padding: 0 20rpx;border-bottom: 2rpx solid #ccc;">{{data.prev_overtop?data.prev_overtop:'ㅤ'}}</view>元
          </view>
        </view>
        <view style="width: 100%;display: flex;">
          <view class="td" style="width: 100%;justify-content: flex-start;padding-left: 20rpx;">
            来源情况：
            <checkbox-group>
            <label class="radio" style="display: inline-block;margin-left: 20rpx;">
              <checkbox color="#0879b5" disabled="{{true}}" value="工资" checked="{{source_of_income[0]}}" />工资
            </label>
            <label class="radio" style="display: inline-block;margin-left: 20rpx;">
              <checkbox color="#0879b5" disabled="{{true}}" value="股票" checked="{{source_of_income[1]}}" />股票
            </label>
            <label class="radio" style="display: inline-block;margin-left: 20rpx;">
              <checkbox color="#0879b5" disabled="{{true}}" value="经营性收入" checked="{{source_of_income[2]}}" />经营性收入
            </label>
            <label class="radio" style="display: inline-block;margin-left: 20rpx;">
              <checkbox color="#0879b5" disabled="{{true}}" value="其他" checked="{{source_of_income[3]}}" />其他<view style="display: inline-block;padding: 0 20rpx;border-bottom: 2rpx solid #ccc;">{{data.other?data.other:'ㅤ'}}</view>
            </label>
            </checkbox-group>
          </view>
        </view>
      </view>
    </view>
    <view style="display: flex;">
      <view class="th" style="width: 3%;">家庭住房情况</view>
      <view style="width: 97%;display: flex;flex-wrap: wrap;">
        <view style="width: 100%;display: flex;">
          <view class="td" style="width: 100%;justify-content: flex-start;padding-left: 20rpx;">该家庭原保障人口为：<view style="display: inline-block;padding: 0 20rpx;border-bottom: 2rpx solid #ccc;">{{data.old_person_num?data.old_person_num:'ㅤ'}}</view>人，现人口增加（减少）<view style="display: inline-block;padding: 0 20rpx;border-bottom: 2rpx solid #ccc;">{{data.change_person_num?data.change_person_num:'ㅤ'}}</view>人，现需保障<view style="display: inline-block;padding: 0 20rpx;border-bottom: 2rpx solid #ccc;">{{data.person_num?data.person_num:'ㅤ'}}</view>人。</view>
        </view>
        <view style="width: 100%;display: flex;">
          <view class="th" style="width: 10%;">姓名</view>
          <view class="th" style="width: 10%;">与户主关系</view>
          <view class="th" style="width: 8%;">姓别</view>
          <view class="th" style="width: 30%;">身份证号</view>
          <view class="th" style="width: 30%;">工作单位</view>
          <view class="th" style="width: 12%;">共同居住</view>
        </view>
        <view style="width: 100%;display: flex;" wx:for="{{data.person}}" wx:key="index">
          <view class="td" style="width: 10%;">{{item.name}}</view>
          <view class="td" style="width: 10%;">{{item.relation}}</view>
          <view class="td" style="width: 8%;">{{item.sex}}</view>
          <view class="td" style="width: 30%;">{{item.id_card}}</view>
          <view class="td" style="width: 30%;">{{item.company}}</view>
          <view class="td" style="width: 12%;">
            <radio-group>
            <label class="radio" style="display: inline-block;">
              <radio color="#0879b5" disabled="{{true}}" value="person.{{index}}.is_reside.1" checked="{{item.is_reside == 1}}" />是
            </label>
            <label class="radio" style="display: inline-block;margin-left: 20rpx;">
              <radio color="#0879b5" disabled="{{true}}" value="person.{{index}}.is_reside.2" checked="{{item.is_reside == 2}}" />否
            </label>
            </radio-group>
          </view>
        </view>
      </view>
    </view>
    <view style="display: flex;">
      <view class="td" style="width: 100%;display: flex;justify-content: space-around;text-align: left;padding: 20rpx 0;">
        <view style="width: 30%;">
          <view>调查员签字：</view>
          <view>社区（签章）：</view>
          <view>ㅤ年ㅤ月ㅤ日</view>
        </view>
        <view style="width: 30%;">
          <view>调查员签字：</view>
          <view>乡镇或街道办事处（签章）：</view>
          <view>ㅤ年ㅤ月ㅤ日</view>
        </view>
        <view style="width: 30%;">
          <view>调查员签字：</view>
          <view>住房保障部门（签章）：</view>
          <view>ㅤ年ㅤ月ㅤ日</view>
        </view>
      </view>
    </view>
  </view>
</view>

<view style="width: 1rpx;height: max(calc(env(safe-area-inset-bottom)), 40rpx);"></view>