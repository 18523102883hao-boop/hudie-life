<view class="stores-page"><view class="stores-heading">商家所有门店 <text class="muted">共 {{stores.length}} 家</text></view><view wx:if="{{loading}}" class="state">加载中…</view><view wx:if="{{error}}" class="state">{{error}}<text class="link" bindtap="load">重试</text></view><view wx:elif="{{!loading && !stores.length}}" class="state">暂无门店</view>
  <view wx:for="{{stores}}" wx:key="store_id" class="branch-card"><view class="branch-name" data-id="{{item.store_id}}" bindtap="openShop">{{item.name}}<text class="branch-arrow">›</text></view><view class="branch-address">{{item.address || '暂无详细地址'}}</view><view wx:if="{{item.distanceText}}" class="distance">{{item.distanceLabel}}{{item.distanceText}}</view><view class="branch-actions"><view class="branch-phone" data-phone="{{item.mobile}}" bindtap="phone">☎ {{item.mobile || '暂无电话'}}</view><view class="navigate {{item.validPoint ? '' : 'navigate-disabled'}}" data-item="{{item}}" bindtap="navigate">{{item.validPoint ? '导航到店' : '暂无坐标'}}</view></view></view>
</view>
