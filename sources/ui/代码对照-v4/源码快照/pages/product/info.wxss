.product-detail-page{width:750rpx}
.product-hero{position:relative;width:750rpx;height:510rpx;background:#fff}
.product-hero-swiper,.product-hero-image{display:block;width:100%;height:100%}
.product-hero-meta{position:absolute;left:24rpx;bottom:38rpx;z-index:2;display:flex;align-items:center;padding:6rpx 12rpx;border-radius:24rpx;background:rgba(0,0,0,.48);color:#fff;font-size:22rpx;line-height:30rpx}
.product-hero-meta .icon{margin-right:4rpx;font-size:24rpx}
.product-hero-divider{margin:0 12rpx;color:rgba(255,255,255,.75)}
.product-summary{box-sizing:border-box;width:750rpx;padding:20rpx 24rpx 26rpx;background:#fff}
.product-title{margin-bottom:24rpx;color:#1b1b1b;font-size:32rpx;font-weight:500;line-height:45rpx;word-break:break-all}
.product-shop-name{color:var(--brand-strong)}
.product-title-divider{color:#777}
.product-price-banner{position:relative;box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;width:100%;height:96rpx;padding:0 24rpx;overflow:hidden;border-radius:10rpx;background-color:#f93453;color:#fff}
.product-price-background{position:absolute;top:0;left:0;z-index:0;width:100%;height:100%}
.product-price-main{position:relative;z-index:1;min-width:0;flex:1}
.product-price-line{display:flex;align-items:baseline;white-space:nowrap;line-height:48rpx}
.product-price-symbol{font-size:30rpx;font-weight:700}
.product-price-value{font-size:42rpx;font-weight:700}
.product-discount{margin-left:12rpx;font-size:22rpx;font-weight:700}
.product-market-price{margin-left:8rpx;font-size:22rpx;font-weight:700;text-decoration:line-through;opacity:.85}
.product-subsidy{display:table;margin-top:-2rpx;padding:0 7rpx;border-radius:14rpx;background:#fff;color:#f42e50;font-size:19rpx;font-weight:700;line-height:24rpx}
.product-price-share{position:relative;z-index:1;flex-shrink:0;width:190rpx;padding-left:14rpx;text-align:center;font-size:29rpx;font-weight:700;font-style:italic;line-height:96rpx}
.product-sale-row{display:flex;align-items:center;justify-content:space-between;gap:8rpx;margin-top:26rpx;color:#666;font-size:23rpx;line-height:36rpx}
.product-sale-stats{display:flex;align-items:center;white-space:nowrap}
.product-sale-divider{margin:0 10rpx;color:#ccc}
.product-countdown{display:flex;align-items:center;gap:3rpx;white-space:nowrap;font-size:20rpx}
.product-time-box{min-width:28rpx;padding:0 3rpx;border-radius:5rpx;background:#272727;color:#fff;text-align:center;font-size:19rpx;line-height:30rpx}
.product-service-row{display:block;box-sizing:border-box;width:100%;margin-top:24rpx;padding-top:0;border-top:0;white-space:nowrap}
.product-service-row .product-detail-service-item{display:inline-flex;max-width:none;margin:0 24rpx 0 0;font-size:23rpx;white-space:nowrap}
.product-detail-content{box-sizing:border-box;width:750rpx;padding:0 20rpx}

.package-card{box-sizing:border-box;width:710rpx;margin-top:20rpx;padding:24rpx 20rpx;background:#fff;border-radius:20rpx;font-size:28rpx}
.package-section-heading{display:flex;align-items:center;justify-content:center;gap:28rpx;margin:0 0 24rpx;color:#111;font-size:32rpx;font-weight:700;line-height:44rpx}
.package-section-heading::before,.package-section-heading::after{content:"";width:40rpx;height:1rpx;background:#d6d6d6}
.package-card-title{padding-bottom:20rpx;border-bottom:1rpx solid #f1f1f1;font-size:30rpx;font-weight:700;line-height:44rpx}
.package-option{position:relative;box-sizing:border-box;margin-top:20rpx;padding:22rpx 24rpx;border:2rpx solid #ddd;border-radius:12rpx;overflow:hidden}
.package-option-selected{border-color:var(--brand-strong);background:#fff8f8}
.package-option-name{font-size:28rpx;line-height:42rpx;font-weight:600;word-break:break-all}
.package-option-meta{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:12rpx;margin-top:14rpx;padding-right:16rpx}
.package-current-price{color:#fe0a0a;font-size:32rpx;font-weight:700;word-break:break-all}
.package-market-price{margin-left:14rpx;color:#999;text-decoration:line-through;font-size:23rpx;word-break:break-all}
.package-sales{color:#999;font-size:23rpx;white-space:nowrap}
.package-selected-mark{position:absolute;bottom:0;right:0;width:34rpx;height:34rpx;border-radius:12rpx 0 0;background:var(--brand-strong);color:#fff;text-align:center;font-size:22rpx;line-height:34rpx}
.package-group{padding:22rpx 0;border-bottom:1rpx solid #f1f1f1}
.package-group-heading{display:flex;flex-wrap:wrap;gap:8rpx 16rpx;font-weight:700;line-height:40rpx;word-break:break-all}
.package-group-rule{color:#888;font-size:24rpx;font-weight:400}
.package-dish{display:flex;align-items:flex-start;gap:16rpx;margin-top:16rpx;font-size:25rpx;line-height:38rpx}
.package-dish-name{flex:1;min-width:0;word-break:break-all}
.package-dish-en{color:#999;font-size:22rpx;line-height:32rpx}
.package-dish-qty{max-width:110rpx;word-break:break-all;color:#666}
.package-dish-price{flex-shrink:0;text-align:right;max-width:160rpx;word-break:break-all;color:#666}
.package-price-strike{text-decoration:line-through}
.package-price-summary{display:flex;flex-wrap:wrap;justify-content:flex-end;align-items:baseline;gap:14rpx;padding-top:24rpx}
.package-price-summary .package-market-price{margin-left:0}
