<view class="root">
  <view class="background"></view>
  <van-nav-bar placeholder="true" custom-class="navbar" fixed border="{{false}}" title="收入明细" left-arrow bind:click-left="onClickLeft" />
  <view class="Arr mt flex" wx:for="{{list}}" wx:key="index">
    <view class="item flex">
      <view style="display: flex;flex-wrap: wrap;">
        <view style="width: 650rpx;font-size: 26rpx;">{{item.msg}}</view>
        <view style="width: 500rpx;font-size: 24rpx;color: #999;line-height: 40rpx;">{{item.add_time}}</view>
        <view wx:if="{{item.type==1}}" style="font-size: 36rpx;color: #ed2519;" class="state">+ {{item.amount}}</view>
        <view wx:else style="font-size: 36rpx;color: #26a23b;" class="state">- {{item.amount}}</view>
      </view>
    </view>
  </view>
</view>

<import src="/utils/common/loading"></import>
<template is="loading" data="{{app,loading,list}}"></template>