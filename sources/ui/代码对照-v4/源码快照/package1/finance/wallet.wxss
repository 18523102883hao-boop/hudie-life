.view{width:710rpx;justify-content:space-between}
.view2{color:#fff}
.bgc{width:4000rpx;height:4000rpx;top: -3500rpx;left:-1625rpx;z-index:-1;border-radius: 2000rpx;background: var(--brand-strong);}
.bgcs{top:0;left:0;width:750rpx;height:300rpx;z-index:-1}
.bgcs image{width:100%;height:100%}
.view1{width:48rpx;height:48rpx}
.view1 image{margin-top:5rpx;width:100%;height:100%}
.userinfo{align-items:center;margin-left:28rpx}
.avatar image{width:100%;height:100%;border-radius:50%}
.nickname{font-size:32rpx;font-family:PingFang SC-Regular,PingFang SC;font-weight:400;color:#fff}
.avatar{width:128rpx;height:128rpx;border-radius:50%;border:1rpx solid #fff}

.shop{width:710rpx;background:var(--brand-soft);border-radius:20rpx;opacity:1;padding:20rpx;box-sizing:border-box;}
.top_address{font-size:28rpx;font-family:PingFang SC-Bold,PingFang SC;font-weight:bold;color:#000;margin-left:28rpx}
.top_address::after{position:absolute;content:'';left:-20rpx;top:8rpx;width:8rpx;height:28rpx;background:var(--brand-strong)}
.icon_item{flex-direction:column;align-items:center;justify-content:center;width:167.5rpx;margin-top: 20rpx;}
.icon_img{width:72rpx;height:72rpx;background:var(--brand-soft);border-radius:50%;text-align: center}
.icon_img .icon_img_box{width: 56rpx;height: 56rpx;background: var(--brand-strong);border-radius: 50%;text-align: center;margin: 8rpx;}
.icon_img .iconfont{color: var(--brand-strong);line-height: 64rpx;font-size: 44rpx}
.icon_img .icon_img_box image{width: 32rpx;height: 32rpx;margin: 12rpx}
.icon_tit{font-size:28rpx;font-family:PingFang SC-Regular,PingFang SC;font-weight:400;color:#000;margin-top:10rpx}