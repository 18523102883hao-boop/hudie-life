<view class="root">
  <van-nav-bar placeholder="true" custom-class="navbar" fixed border="{{false}}" title="订单核销" left-arrow bind:click-left="onClickLeft" />
</view>

<view style="width: 710rpx;margin: 20rpx;display: flex;">
  <view class="input flex">
		<view class="input1"></view>
		<view class="input2">
			<input type="text" placeholder="请输入券码" model:value="{{code}}" bindconfirm="search" />
		</view>
		<view class="input3 mr" catchtap="scan" style="background:var(--action-background);color:#fff;" hover-class="theme-action-hover">
      <text class="icon iconfont icon-scan" style="font-size: 48rpx;"></text>
		</view>
	</view>
  <view catchtap="search" style="width: 80rpx;height: 80rpx;line-height: 80rpx;text-align: center;background:var(--action-background);color: #fff;font-size: 40rpx;border-radius: 20rpx;margin-left: 20rpx;" hover-class="theme-action-hover"><text class="icon iconfont icon-search"></text></view>
</view>

<view catchtap="verifyOrder" data-item="{{item}}" wx:for="{{list}}" wx:key="index" style="width: 670rpx;margin: 20rpx;background: #fff;padding: 20rpx;border-radius: 20rpx;">
  <view style="display: flex;justify-content: space-between;line-height: 40rpx;">
    <view style="font-size: 24rpx;font-weight: 700;">订单号：{{item.no}}</view>
    <view style="font-size: 30rpx;">
      <view wx:if="{{item.status == 1}}" style="background: #fbfaf6;border-color: #f9f3e3;color: #fbe5b1;">待支付</view>
      <view wx:elif="{{item.status == 2}}" style="background: #f6ffed;border-color: #b7eb8f;color: #52c41a;">待使用</view>
      <view wx:elif="{{item.status == 20}}" style="background: #effbf2;border-color: #c3f7d2;color: #5fb878;">部分使用</view>
      <view wx:elif="{{item.status == 3}}" style="background: #fdf5f0;border-color: #ffd3be;color: #f66c2c;">已完成</view>
      <view wx:elif="{{item.status == 4}}" style="background: #fffde4;border-color: #fdf7a5;color: #ffee00;">已过期</view>
      <view wx:elif="{{item.status == 9}}" style="background: #fff1f0;border-color: #ffa39e;color: #f5222d;">已退款</view>
      <view wx:elif="{{item.status == -1}}" style="background: #ffffff;border-color: #f4f4f4;color: #333333;">已取消</view>
      <view wx:else style="background: #ffffff;border-color: #f4f4f4;color: #999;">未知</view>
    </view>
  </view>
  <view style="display: flex;width: 670rpx;margin-top: 10rpx;align-items: stretch;">
    <view style="width: 200rpx;height: 200rpx;">
      <image src="{{item.img}}" style="width: 100%;height: 100%;border-radius: 20rpx;"></image>
    </view>
    <view style="width: 460rpx;margin-left: 10rpx;font-size: 28rpx;color: #555;">
      <view style="font-weight: 700;color: var(--brand-strong);">{{item.order_type}}</view>
      <view style="line-height: 38rpx;display: -webkit-box;-webkit-box-orient: vertical;-webkit-line-clamp: 2;overflow: hidden;text-overflow: ellipsis;height: 76rpx;">{{item.title}}</view>
      <view style="font-size: 24rpx;margin: 4rpx 0;display: flex;justify-content: space-between;"><view>券码：</view><view>{{item.code}}</view></view>
      <view style="font-size: 24rpx;margin: 4rpx 0;display: flex;justify-content: space-between;"><view>用户昵称：</view><view>{{item.nickname}}</view></view>
      <view style="font-size: 24rpx;margin: 4rpx 0;display: flex;justify-content: space-between;"><view>联系电话：</view><view>{{item.mobile}}</view></view>
    </view>
  </view>
</view>

<import src="/utils/common/loading"></import>
<template is="loading" data="{{app,loading,list}}"></template>