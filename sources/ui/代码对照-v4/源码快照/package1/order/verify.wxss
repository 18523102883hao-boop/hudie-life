.root .van-icon-arrow-left{color:var(--nav-bar-icon-color,#000) !important;z-index:10}
.root .van-nav-bar{color:rgba(0,0,0,1) !important;background-color:#fff !important}
.input{width:600rpx;height:80rpx;background:#fff;border-radius:20rpx;opacity:1;border:2rpx solid #fff}
.input{align-items:center}
.input1{width:2rpx;height:24rpx;background-color:#aaaaaa;margin:0 26rpx}
.input2{flex:1;font-size:28rpx;font-family:PingFang SC-Regular,PingFang SC;font-weight:400;color:#AAAAAA}
.input2 input{width:100%;height:100%;letter-spacing:5rpx}
.exchange{width:632rpx;height:90rpx;background:var(--action-background);border-radius:50rpx;opacity:1;text-align:center;line-height:90rpx;font-size:32rpx;font-family:PingFang SC-Regular,PingFang SC;font-weight:400;color:#fff;margin:0 auto;margin-top:100rpx}
.prompt{margin-top:64rpx;font-size:28rpx;font-family:PingFang SC-Bold,PingFang SC;font-weight:bold;color:#333333}
.main1{font-size:28rpx;font-family:PingFang SC-Regular,PingFang SC;font-weight:400;color:#333333;margin-bottom:30rpx;line-height:40rpx}
.input3{width:48rpx;height:48rpx}
.input3 image{width:48rpx;height:48rpx}