<template name="goods_list">
  <view style="width: 670rpx;padding: 20rpx;margin: 20rpx 20rpx 0;background: #fff;border-radius: 20rpx;display: flex;justify-content: space-between;" wx:for="{{list}}" wx:key="index" catchtap="viewGoods" data-id="{{item.id}}" data-type="{{item.type}}">
  <view style="width: 200rpx;height: 200rpx;position: relative;overflow: hidden;border-radius: 20rpx;">
    <view style="width: 180rpx;height: 180rpx;background-image: url({{item.img}});background-size: 100% 100%;filter: blur(5px);margin: 10rpx"></view>
    <image src="{{item.img}}" style="width: 200rpx;height: 200rpx;position: absolute;z-index: 1;top: 0;left: 0;border-radius: 20rpx;"></image>
    <view wx:if="{{item.need_book == 0}}" style="position:absolute;left:0;top:0;z-index:2;background:#00bd52;color:#fff;font-size:24rpx;font-weight:700;line-height:36rpx;padding:0 10rpx;border-radius:20rpx 0 12rpx 0;">免预约</view>
  </view>
  <view style="width: 450rpx;min-height: 210rpx;position: relative;">
    <view style="width: 450rpx;display: flex;">
      <view wx:if="{{item.type == 1}}" style="background: #fb143d;color: #fff;font-weight: 700;padding: 0 10rpx;text-align: center;font-size: 24rpx;border-radius: 10rpx;line-height: 36rpx;margin-right: 10rpx;">蝴蝶优选补贴</view>
      <view wx:if="{{item.type == 1}}" style="background: #fd596a;color: #fff;font-weight: 700;padding: 0 10rpx;text-align: center;font-size: 24rpx;border-radius: 10rpx;line-height: 36rpx;margin-right: 10rpx;">最高补贴{{item.max_bt}}元</view>
    </view>
    <view style="width: 450rpx;height: 84rpx;display: flex;align-items: center;flex-wrap: wrap;">
      <view style="width: 450rpx;font-size: 28rpx;font-weight: 600;display: -webkit-box;-webkit-box-orient: vertical;-webkit-line-clamp: 2;overflow: hidden;text-overflow: ellipsis;line-height: 42rpx;height: 84rpx;">
        <text style="color: #a65336;font-size:34rpx;font-weight:800;">{{item.shop_name}}</text><text style="color: #9f9f9f;font-weight: 100;">丨</text>
        {{item.title}}
      </view>
    </view>
    <view style="width: 450rpx;display: flex;flex-wrap: wrap;margin-top: 8rpx;">
      <text wx:if="{{item.distant}}" style="display:inline-block;background:var(--action-background);color:#fff;border-radius:8rpx;padding:2rpx 10rpx;font-size:20rpx;margin-right:6rpx;margin-bottom:6rpx;line-height:30rpx;"><text class="icon iconfont icon-location" style="font-size:20rpx;margin-right:4rpx;"></text>{{item.distant}}</text>
      <text wx:for="{{item.tag}}" wx:key="*this" wx:for-item="gtag" wx:if="{{gtag}}" style="display:inline-block;border:1rpx solid #ed5219;color:#ed2519;border-radius:8rpx;padding:2rpx 8rpx;font-size:20rpx;margin-right:6rpx;margin-bottom:6rpx;line-height:30rpx;">{{gtag}}</text>
    </view>
    <view style="width: 450rpx;height: 90rpx;position: relative;display: flex;justify-content: space-between;font-size: 24rpx;color: #999;line-height: 44rpx;flex-wrap: wrap;border-radius: 38rpx;background-image: linear-gradient(to right, #fff, #fdeee9);">
      <view style="width: 230rpx;">
        <view style="font-weight: 700;color: #ff3d24;width: 336rpx;margin-top: 4rpx;">
          ￥<text style="font-size: 38rpx;">{{item.subsidy_price}} </text>
          <text style="color: #777;text-decoration: line-through;font-weight: 100;">￥{{item.market_price}}</text>
        </view>
        <view style="width: 336rpx;line-height: 20rpx;font-size: 20rpx;display: flex;">
          <view style="color: #ff0a0a;border-radius: 10rpx;margin-right: 6rpx;margin-top: 6rpx;font-weight: 700;font-size: 22rpx;background-image: url({{app.domain}}static/img/icon-commission.png);background-size: 20rpx 20rpx;background-repeat: no-repeat;padding-left: 26rpx;" wx:if="{{item.max_commission}}">自购省 {{item.max_commission}} | 分享赚 {{item.max_commission}}</view>
        </view>
      </view>
      
      <view style="width: 114rpx;">
        <view style="display: flex;justify-content: space-between;font-size: 24rpx;color: #999;line-height: 44rpx;flex-wrap: wrap;position: absolute;right: 0;bottom: 0;height: 90rpx;background-image: linear-gradient(to right, #fff, #fdeee9);border-radius: 38rpx;">
          <view hover-class="theme-action-hover" style="width: 114rpx;height: 90rpx;background: var(--action-background);border-radius: 38rpx;color: #fff;text-align: right;font-weight: 700;vertical-align: middle;position: relative;" >
            <view style="font-size: 40rpx;line-height: 90rpx;padding-right: 40rpx;">抢<text class="icon iconfont icon-jiantouyou" style="font-size: 20rpx;position: absolute;right: 18rpx;"></text></view>
          </view>
        </view>
      </view>
      <view wx:if="{{0}}" style="width: 220rpx;height: 90rpx;display: flex;align-items: flex-end;justify-content: flex-end;">
        <view wx:if="{{item.status!=1}}" style="width: 180rpx;height: 56rpx;font-weight: 700;font-size: 24rpx;display: flex;justify-content: center;background-image: linear-gradient(to right, #f1f1f1, #d1d1d1);background-size: 100% 100%;line-height: 56rpx;text-align: center;border-radius: 28rpx;text-align: center;color: #333">
          {{item.start_time <= now_time ? '已下架' : '未上架'}}
        </view>
        <view wx:elif="{{item.end_time<now_time}}" style="width: 180rpx;height: 56rpx;font-weight: 700;font-size: 24rpx;display: flex;justify-content: center;background-image: linear-gradient(to right, #f1f1f1, #d1d1d1);background-size: 100% 100%;line-height: 56rpx;text-align: center;border-radius: 28rpx;text-align: center;color: #333">
          已下架
        </view>
        <view wx:elif="{{item.start_time>now_time}}" style="width: 180rpx;height: 56rpx;font-weight: 700;font-size: 24rpx;display: flex;justify-content: center;background-image: linear-gradient(to right, #ffe79c, #ffbb17);background-size: 100% 100%;line-height: 56rpx;text-align: center;border-radius: 28rpx;text-align: center;color: #fff">{{item.start_date}} 开售</view>
        <view wx:elif="{{item.stock<=item.today_sale_num}}" style="width: 180rpx;height: 56rpx;font-weight: 700;font-size: 24rpx;display: flex;justify-content: center;background-image: linear-gradient(to right, #f1f1f1, #d1d1d1);background-size: 100% 100%;line-height: 56rpx;text-align: center;border-radius: 28rpx;text-align: center;color: #333">已抢光</view>
        <view wx:elif="{{item.type == 1}}" style="width: 220rpx;height: 56rpx;font-weight: 700;font-size: 24rpx;display: flex;align-items: flex-end;justify-content: flex-end;background: var(--action-background);border-radius: 28rpx;background-size: 100% 100%;line-height: 56rpx;text-align: center;">
          <view style="width: 110rpx;height: 56rpx;color: #fff;font-size: 20rpx;">最低砍至</view>
          <view style="width: 110rpx;height: 56rpx;color: #fff;">￥{{item.min_price}}</view>
        </view>
        <view wx:elif="{{item.type == 3}}" style="width: 180rpx;height: 56rpx;font-weight: 700;font-size: 24rpx;display: flex;align-items: flex-end;justify-content: flex-end;background:var(--action-background);background-size: 100% 100%;line-height: 56rpx;text-align: center;border-radius: 28rpx;text-align: center;color: #fff">
          {{item.group_num}}人团
        </view>
        <view wx:else style="width: 180rpx;height: 56rpx;font-weight: 700;font-size: 24rpx;display: flex;justify-content: center;background:var(--action-background);background-size: 100% 100%;line-height: 56rpx;text-align: center;border-radius: 28rpx;text-align: center;color: #fff">
          立即购买
        </view>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{show_cut_msg}}" style="position: fixed;left: 0;top: 0;background: #00000066;z-index: 9;width: 100%;height: 100%;">
  <view hover-class="theme-action-hover" style="position: absolute;right: 50rpx;top: calc(50vh - 250rpx);color: #fff;z-index: 1;font-size: 24rpx;width: 120rpx;background: var(--action-background);text-align: center;line-height: 40rpx;border-radius: 20rpx;" catchtap="closeCutMsg">关闭 {{sec>0?sec:''}}</view>
  <view style="position: absolute;height: 400rpx;width: 650rpx;left: 50rpx;background: #fff;top: calc(50vh - 200rpx);border-radius: 20rpx;">
    <view style="line-height: 80rpx;font-size: 40rpx;text-align: center;font-weight: 700;margin: 40rpx 0 0;">恭喜成功砍掉</view>
    <view style="line-height: 80rpx;font-size: 60rpx;color: #fe0a0a;font-weight: 700;text-align: center;margin-top: 20rpx;">{{cut_price}}元</view>
    <view wx:if="{{0}}" style="width: 550rpx;margin: 30rpx 50rpx;font-size: 26rpx;">今日您的砍价机会已用完（<text style="color: #fe0a0a;">每个账号一天只可砍价一次</text>），点击“<text style="color: #fe0a0a;">邀请帮砍</text>”召集更多好友一起砍价！</view>
    <view style="width: 600rpx;margin: 30rpx 25rpx;font-size: 26rpx;">砍价成功，当前商品最终价格仅当日有效，先抢先得</view>
  </view>
</view>
<view wx:if="{{show_share}}" style="position: fixed;left: 0;top: 0;background: #00000066;z-index: 9;width: 100%;height: 100%;">
  <view style="position: absolute;width: 620rpx;height: 850rpx;left: 65rpx;top: calc((100vh - 850rpx - env(safe-area-inset-bottom) - 390rpx +  {{app.globalData.navBarHeight}}px) / 2)" wx:if="{{goods.poster}}">
    <image show-menu-by-longpress src="{{goods.poster}}" style="width: 620rpx;height: 850rpx;"></image>
  </view>
  <view style="position: absolute;bottom: 0;left: 0;">
    <view style="background: #fff;padding: 30rpx 40rpx 20rpx;border-radius: 20rpx 20rpx 0 0;">
      <view style="display: flex;text-align: center;border-bottom: 1px solid #f1f1f1;padding-bottom: 20rpx;">
        <button plain="true" open-type="share" hover-class="theme-share-hover" style="width: 33.33%;box-sizing: border-box;padding: 0;border: 0;font-weight: 100;font-size: 28rpx;border-right: 1px solid #f1f1f1;">
          <view class="theme-action-icon" style="width: 109rpx;height: 108rpx;background: var(--action-background);color: #fff;font-size: 70rpx;line-height: 108rpx;border-radius: 24rpx;display: inline-block;">↗</view>
          <view>发送给好友</view>
        </button>
        <view hover-class="theme-share-hover" catchtap="savePoster" style="width: 33.33%;border-right: 1px solid #f1f1f1;box-sizing: border-box;font-weight: 100;font-size: 28rpx;">
          <view class="theme-action-icon" style="width: 109rpx;height: 108rpx;background:var(--action-background);color: #fff;font-size: 64rpx;line-height: 108rpx;border-radius: 24rpx;display: inline-block;">↓</view>
          <view>保存海报</view>
        </view>
        <view hover-class="theme-share-hover" catchtap="toBuy" style="width: 33.33%;font-weight: 100;font-size: 28rpx;">
          <view class="theme-action-icon" style="width: 109rpx;height: 108rpx;background:var(--action-background);color: #fff;font-size: 64rpx;line-height: 108rpx;border-radius: 24rpx;display: inline-block;">¥</view>
          <view>立即购买</view>
        </view>
      </view>
      <view hover-class="theme-action-hover" style="text-align: center;margin-top: 20rpx;background:var(--action-background);color:#fff;border-radius:20rpx;" catchtap="closeShare">关闭</view>
    </view>
    <view style="width: 750rpx;height: calc(env(safe-area-inset-bottom));background: #f1f1f1;"></view>
  </view>
</view>
</template>
