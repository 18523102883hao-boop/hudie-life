<view class="filter">
  <view class="bar">
    <view class="cell {{categoryId ? 'chosen' : ''}}" data-field="categoryId" bindtap="toggle"><text>{{categoryLabel}}</text><text class="arrow">▾</text></view>
    <view class="cell {{orderChosen ? 'chosen' : ''}}" data-field="order" bindtap="toggle"><text>{{orderLabel}}</text><text class="arrow">▾</text></view>
    <view class="cell {{county ? 'chosen' : ''}}" data-field="county" bindtap="toggle"><text>{{county || '区域'}}</text><text class="arrow">▾</text></view>
  </view>
  <view wx:if="{{open}}" class="mask" bindtap="close"></view>
  <scroll-view wx:if="{{open}}" scroll-y class="options">
    <block wx:if="{{open === 'categoryId'}}">
      <view class="option {{!categoryId ? 'chosen' : ''}}" bindtap="choose" data-field="categoryId" data-value="">全部 <text wx:if="{{!categoryId}}">✓</text></view>
      <view wx:for="{{categories}}" wx:key="id" class="option {{categoryId == item.id ? 'chosen' : ''}}" bindtap="choose" data-field="categoryId" data-value="{{item.id}}">{{item.name}} <text wx:if="{{categoryId == item.id}}">✓</text></view>
    </block>
    <block wx:elif="{{open === 'order'}}"><view wx:for="{{orders}}" wx:key="value" class="option {{order === item.value ? 'chosen' : ''}}" bindtap="choose" data-field="order" data-value="{{item.value}}">{{item.name}} <text wx:if="{{order === item.value}}">✓</text></view></block>
    <block wx:else>
      <view class="option {{!county ? 'chosen' : ''}}" bindtap="choose" data-field="county" data-value="">全部 <text wx:if="{{!county}}">✓</text></view>
      <view wx:for="{{districts}}" wx:key="county" class="option {{county === item.county ? 'chosen' : ''}}" bindtap="choose" data-field="county" data-value="{{item.county}}">{{item.county}} <text wx:if="{{county === item.county}}">✓</text></view>
    </block>
  </scroll-view>
</view>
